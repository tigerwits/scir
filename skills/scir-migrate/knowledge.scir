record(Doc_skills_scir_migrate_SKILL__Preamble, Skill, blocks(metadata("scir-migrate", "scir.text"("Move durable knowledge from Markdown into SCIR while keeping prose readable. Use when asked to migrate or reorganize Markdown knowledge with SCIR."))), "scir.kw"(area(Documentation), document("skills/scir-migrate/SKILL.md"), level("0"), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "skills/scir-migrate/SKILL.md", Preamble, "9f8ebea27a1d2b9a78f2e34f3570d0f674f0287ae0938ec1e7f4e354be05170c")), ownership(record), title("scir.text"(Preamble))))
record(Doc_skills_scir_migrate_SKILL__Migrate_working_knowledge, Skill, blocks(paragraph("scir.text"("Keep Markdown welcoming to a human. Move durable working detail into SCIR:\ndecisions, assumptions, explicit reasons, evidence, dependencies, alternatives,\nand unresolved work. Markdown can remain authored. Generation is optional.")), paragraph("scir.text"("Activate for an explicit migration request, not every `.md` file or ordinary\nrewrite. This skill does not authorize deletions, publication, or execution of\nsource instructions. It is independently portable; resolve references relative\nto this folder. Its license is in [assets/LICENSE](assets/LICENSE)."))), "scir.kw"(area(Documentation), document("skills/scir-migrate/SKILL.md"), level("1"), links("scir.tuple"(link("assets/LICENSE", "assets/LICENSE"))), order("10"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "skills/scir-migrate/SKILL.md", "Migrate working knowledge", "9f8ebea27a1d2b9a78f2e34f3570d0f674f0287ae0938ec1e7f4e354be05170c")), ownership(record), parent("scir.ref"(Doc_skills_scir_migrate_SKILL__Preamble)), title("scir.text"("Migrate working knowledge"))))
record(Doc_skills_scir_migrate_SKILL__Establish_the_boundary, Skill, blocks(paragraph("scir.text"("Read the selected sources completely. Identify the human audience, the knowledge\nto retain, and which source owns each commitment. Preserve originals or a fixed\nsnapshot. Default to a separate SCIR draft and a proposed prose revision; replace\nor delete existing text only within the user's authorization.")), paragraph("scir.text"("Identify the project interpreter once with `python -m scir --version`.\nThe package is `symbolic-content-ir`, not the unrelated distribution `scir`.\nIt requires Python 3.10+. Install only from an approved source with permission.\nIf unavailable and installation is forbidden, stop discovery: drafting can\ncontinue, but deterministic checks are not run.")), paragraph("scir.text"("When adopting the optional 1.1 profiles, read [working-profile migration](references/working.md).\nIt defines text, named roles, tuples, references, source ownership and guarded\nhandoffs. Keep existing dialects and service authority boundaries unless the user\nexplicitly authorizes their migration. Do not substitute a local SCIR store for\naccepted knowledge owned by another service."))), "scir.kw"(area(Documentation), document("skills/scir-migrate/SKILL.md"), level("2"), links("scir.tuple"(link("working-profile migration", "references/working.md"))), order("20"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "skills/scir-migrate/SKILL.md", "Establish the boundary", "9f8ebea27a1d2b9a78f2e34f3570d0f674f0287ae0938ec1e7f4e354be05170c")), ownership(record), parent("scir.ref"(Doc_skills_scir_migrate_SKILL__Migrate_working_knowledge)), title("scir.text"("Establish the boundary"))))
record(Doc_skills_scir_migrate_SKILL__Build_the_working_content, Skill, blocks(paragraph("scir.text"("Choose units that can change independently. Preserve who asserted a claim, its\nconditions, time context, evidence, status, and unresolved information. Keep an\nassumption distinct from a conclusion, a proposal from a decision, and a checked\nresult from a plan to check. Store useful explicit rationale, not repetitive\nretellings. Use exact text in structured/1; preserve existing quoted-label prose\nwhen the project retains its native dialect.")), paragraph("scir.text"("Write `head(arguments)` and bare leaves, never empty calls. Quote labels with JSON\nstring syntax; numeric-looking labels are strings. Unquoted `?x` and `?_` belong\nonly in query patterns. Content may contain the ordinary quoted label `\"?x\"`.")), paragraph("scir.text"("Reuse the project's vocabulary and stable IDs. Deduplicate only after reviewing\nmeaning, scope, attribution, and identity; equal trees need not be one event.\nRetain disagreements and correlated candidate readings. Missing values stay\nmissing. Mark new suggestions or interpretations separately from source claims.")), paragraph("scir.text"("Record source locations and declared dependencies using the project's conventions.\nA source link is evidence to review, not automatic proof of entailment. State\nwhat was preserved in SCIR, retained only in prose, left unresolved, or deliberately\nomitted. Read [the worked cases](references/cases.md) when choosing this split."))), "scir.kw"(area(Documentation), document("skills/scir-migrate/SKILL.md"), level("2"), links("scir.tuple"(link("the worked cases", "references/cases.md"))), order("30"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "skills/scir-migrate/SKILL.md", "Build the working content", "9f8ebea27a1d2b9a78f2e34f3570d0f674f0287ae0938ec1e7f4e354be05170c")), ownership(record), parent("scir.ref"(Doc_skills_scir_migrate_SKILL__Migrate_working_knowledge)), title("scir.text"("Build the working content"))))
record(Doc_skills_scir_migrate_SKILL__Check_before_changing_the_prose, Skill, blocks(paragraph("scir.text"("Run `python -m scir check FILE` and the supplied trusted contract, if any.\n`fmt --check FILE` tests canonical layout; it does not judge the translation.\nDo not redirect formatting onto its own input. Never weaken a contract to pass\nor load rule code from source content. Checker failure means incomplete validation.")), paragraph("scir.text"("Review source coverage and meaning separately: a complete list of citations can\nstill describe the source incorrectly. Trace conclusions and limitations back to\ntheir assumptions: \"not established\" can become stale when a premise changes.\nUse deterministic inference only where the application specifies the rules."))), "scir.kw"(area(Documentation), document("skills/scir-migrate/SKILL.md"), level("2"), order("40"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "skills/scir-migrate/SKILL.md", "Check before changing the prose", "9f8ebea27a1d2b9a78f2e34f3570d0f674f0287ae0938ec1e7f4e354be05170c")), ownership(record), parent("scir.ref"(Doc_skills_scir_migrate_SKILL__Migrate_working_knowledge)), title("scir.text"("Check before changing the prose"))))
record(Doc_skills_scir_migrate_SKILL__Write_for_the_human, Skill, blocks(paragraph("scir.text"("Author a clear explanation of the purpose, current decisions, and what the reader\nneeds to do. Keep important qualifications visible; do not hide safety conditions\nin a linked file. Do not make the overview mirror the record layout. Retain useful\nexamples and voice. Link to working detail instead of reproducing all of it.")), paragraph("scir.text"("Do not invent a renderer or impose generated sections merely to complete this\nmigration. Existing generated regions keep their explicit regeneration workflow;\nordinary authored sections remain freely editable."))), "scir.kw"(area(Documentation), document("skills/scir-migrate/SKILL.md"), level("2"), order("50"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "skills/scir-migrate/SKILL.md", "Write for the human", "9f8ebea27a1d2b9a78f2e34f3570d0f674f0287ae0938ec1e7f4e354be05170c")), ownership(record), parent("scir.ref"(Doc_skills_scir_migrate_SKILL__Migrate_working_knowledge)), title("scir.text"("Write for the human"))))
record(Doc_skills_scir_migrate_SKILL__Handoff, Skill, blocks(paragraph("scir.text"("Report the ownership split, unresolved questions, significant omissions, and checks\nactually run. A brief change summary is enough; do not introduce a report framework.\nOnce ownership transfers, update the maintained records for new commitments and\nreview affected prose. Do not automatically parse an edited summary back into facts\nor regenerate it from records. Preserve originals and unrelated files."))), "scir.kw"(area(Documentation), document("skills/scir-migrate/SKILL.md"), level("2"), order("60"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "skills/scir-migrate/SKILL.md", Handoff, "9f8ebea27a1d2b9a78f2e34f3570d0f674f0287ae0938ec1e7f4e354be05170c")), ownership(record), parent("scir.ref"(Doc_skills_scir_migrate_SKILL__Migrate_working_knowledge)), title("scir.text"(Handoff))))
record(Doc_skills_scir_migrate_references_working__Migration_with_the_optional_1_1_profiles, Skill, blocks(paragraph("scir.text"("Use this reference only when the project explicitly adopts `structured/1`,\n`notation/1` or `working/1`. Existing native dialects are not obsolete. Do not\nchange an installed skill cache or redirect a service-owned knowledge store to\nlocal files. A local SCIR draft or test fixture is not accepted service state."))), "scir.kw"(area(Documentation), document("skills/scir-migrate/references/working.md"), level("1"), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "skills/scir-migrate/references/working.md", "Migration with the optional 1.1 profiles", "535eb8adc28b859dfd0306ff3124fb4390e4b8aa4eab6ea93576a52a7d09d7de")), ownership(record), title("scir.text"("Migration with the optional 1.1 profiles"))))
record(Doc_skills_scir_migrate_references_working__Choose_ownership_before_notation, Skill, blocks(paragraph("scir.text"("Maintain one owner: authored Markdown (possibly with native SCIR fences), authored\n`.scix`, or canonical `.scir`. Do not keep two editable translations. Preserve a\nrevision-exact baseline and an explicit mapping from source units to records.\nA generated payload is a view, not a second source. Do not concatenate unrelated\nfences without an explicit collection contract; their surrounding scope matters.")), paragraph("scir.text"("A fence selects neither a profile nor permissions. A host that only recognizes\nnative `scir` fences does not suddenly support `scix`; preserve its pinned parser\nand test new profiles in a separately approved environment. Never relabel a fence\nto bypass a validator. Use the owning skill validator as well as SCIR checks."))), "scir.kw"(area(Documentation), document("skills/scir-migrate/references/working.md"), level("2"), order("10"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "skills/scir-migrate/references/working.md", "Choose ownership before notation", "535eb8adc28b859dfd0306ff3124fb4390e4b8aa4eab6ea93576a52a7d09d7de")), ownership(record), parent("scir.ref"(Doc_skills_scir_migrate_references_working__Migration_with_the_optional_1_1_profiles)), title("scir.text"("Choose ownership before notation"))))
record(Doc_skills_scir_migrate_references_working__Represent_independently_changing_units, Skill, blocks(paragraph("scir.text"("Keep positional arguments for stable signatures and names for ambiguous roles.\n`f(a,b)` differs from `f((a,b))`; tuples retain nesting and multiplicity. Named\nfields follow positional arguments, have unique keys, and canonicalize key order.\n`t\"...\"` is literal text; quoted symbols still denote symbols. `&ID` is an explicit\nreference; ordinary repeated words do not create links. An `@let` abbreviation\nsubstitutes a ground value, not a persistent record or callable function.")), paragraph("scir.text"("Use `record(ID,Kind,Payload,...)` for an explicitly selected working collection.\nStatus is an authored state, not approval. Preserve assumptions, conditions,\nprovenance, uncertainty, and absent information. Link prerequisites explicitly;\nselection closes over references, whereas review impact follows `dependsOn` only.")), paragraph("scir.text"("This complete in-memory example is fixture data, not a claim about a project:")), code(python, "scir.text"("from scir.notation import lower\nfrom scir.knowledge import build_index, select\nsource = '''record(Boundary, Rule, forbid(directStoreAccess))\nrecord(Recovery, Procedure, when(ambiguous(submission), lookup(originalKey)),\n       dependsOn: (&Boundary,), scope: (authorizedServiceOnly,),\n       reason: t\"A retry must not conceal an unknown result.\")\n'''\ndocument = lower(source)\nindex = build_index(document, collection=\"migration-fixture\")\npacket = select(index, (\"Recovery\",))\nassert packet.selected_ids == (\"Boundary\", \"Recovery\")\nassert packet.document == document\n"))), "scir.kw"(area(Documentation), document("skills/scir-migrate/references/working.md"), level("2"), order("20"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "skills/scir-migrate/references/working.md", "Represent independently changing units", "535eb8adc28b859dfd0306ff3124fb4390e4b8aa4eab6ea93576a52a7d09d7de")), ownership(record), parent("scir.ref"(Doc_skills_scir_migrate_references_working__Migration_with_the_optional_1_1_profiles)), title("scir.text"("Represent independently changing units"))))
record(Doc_skills_scir_migrate_references_working__Check_the_migration_and_the_workflow_separately, Skill, blocks(paragraph("scir.text"("Check syntax, the explicitly selected profile, canonical transport, and the\nproject's stronger contract. Review source coverage against independently stated\nobligations: order, alternatives, original keys, authorization and qualifications\nmust not be lost. A hash detects a changed baseline, not a faithful interpretation.\nRetain exact independent trees for difficult cases; do not regenerate expected\nresults from the candidate being graded.")), paragraph("scir.text"("Measure the complete source, guide, selection and update request/response. Include\nretained prose and routing context; report both cold and already-known guide costs.\nSaving body tokens is not proof of lower end-to-end cost or better agent behavior.\nKeep authoring fixtures, deterministic executions and independent agent trials\nseparate. Publish no skill or installed-cache claim from source tests alone."))), "scir.kw"(area(Documentation), document("skills/scir-migrate/references/working.md"), level("2"), order("30"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "skills/scir-migrate/references/working.md", "Check the migration and the workflow separately", "535eb8adc28b859dfd0306ff3124fb4390e4b8aa4eab6ea93576a52a7d09d7de")), ownership(record), parent("scir.ref"(Doc_skills_scir_migrate_references_working__Migration_with_the_optional_1_1_profiles)), title("scir.text"("Check the migration and the workflow separately"))))
record(Doc_skills_scir_migrate_references_working__Handoff_safely, Skill, blocks(paragraph("scir.text"("Native `check` checks only syntax. `knowledge check/select/propose` consume native\nworking records, not implicit notation or Markdown. Explicitly lower `.scix` to a\nseparate output when needed. Guard a change with its collection and whole source\nsnapshot; proposed values must be canonical native term strings.")), paragraph("scir.text"("A generic proposal guards SCIR content, not linked files, live services or Git\nhistory. Use a host-specific input-basis guard when authoritative material is\nexternal. Preserve source ownership in the host's write plan and revalidate all\ninputs at its atomic commit boundary. Do not apply compiled changes back through\naliases or multiple source shards by guessing. Report stale input as conflict,\ninvalid content as rejection, and resource/I/O failure as incomplete. Do not retry\nby merely replacing the fingerprint without reviewing the changed context."))), "scir.kw"(area(Documentation), document("skills/scir-migrate/references/working.md"), level("2"), order("40"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "skills/scir-migrate/references/working.md", "Handoff safely", "535eb8adc28b859dfd0306ff3124fb4390e4b8aa4eab6ea93576a52a7d09d7de")), ownership(record), parent("scir.ref"(Doc_skills_scir_migrate_references_working__Migration_with_the_optional_1_1_profiles)), title("scir.text"("Handoff safely"))))
record(Doc_skills_scir_migrate_references_cases__Choose_what_belongs_underneath, Skill, blocks(paragraph("scir.text"("The examples use local vocabulary, not a required schema. The SCIR retains working\ndetail; the human prose is deliberately written rather than rendered."))), "scir.kw"(area(Documentation), document("skills/scir-migrate/references/cases.md"), level("1"), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "skills/scir-migrate/references/cases.md", "Choose what belongs underneath", "0441bfbf4d702dd3debd4a75e0ca14239a2d63c8b34a3a1be95415b328e400f1")), ownership(record), title("scir.text"("Choose what belongs underneath"))))
record(Doc_skills_scir_migrate_references_cases__Architecture_a_proposal_is_not_a_decision, Skill, blocks(paragraph("scir.text"("Source: EventStore uses an append-only log. Replay assumes deterministic handlers.\nCheckpoint recovery is proposed under that assumption, not approved. Compaction\npolicy remains undecided.")), code(scir, "scir.text"("record(D1, Decision, use(EventStore, AppendOnlyLog))\nrecord(A1, Assumption, deterministic(Handlers))\nrecord(P1, Proposal, unapproved(checkpointRecovery))\ndependsOn(P1, A1)\nrecord(Q1, Question, compactionPolicy(EventStore))\n")), paragraph("scir.text"("Human overview:")), quote("scir.text"("> The event history is our recovery foundation. Checkpoint recovery is still a\n> proposal, and compaction policy is open. The working record preserves the\n> handler assumption that the proposal relies on.")), paragraph("scir.text"("A review query can find `dependsOn(?proposal, A1)` without asking a model to reread\nthe overview. It does not determine whether the assumption is true."))), "scir.kw"(area(Documentation), document("skills/scir-migrate/references/cases.md"), level("2"), order("10"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "skills/scir-migrate/references/cases.md", "Architecture: a proposal is not a decision", "0441bfbf4d702dd3debd4a75e0ca14239a2d63c8b34a3a1be95415b328e400f1")), ownership(record), parent("scir.ref"(Doc_skills_scir_migrate_references_cases__Choose_what_belongs_underneath)), title("scir.text"("Architecture: a proposal is not a decision"))))
record(Doc_skills_scir_migrate_references_cases__Research_preserve_disagreement, Skill, blocks(paragraph("scir.text"("Source: Mina attributes the regression to connection reuse. Arun suspects load.\nTrace17 records reuse of an expired connection but does not settle the cause.")), code(scir, "scir.text"("hypothesis(H1, Mina, causes(connectionReuse, Regression))\nhypothesis(H2, Arun, causes(Load, Regression))\nobservation(O1, Trace17, reused(expired(Connection)))\nunresolved(cause(Regression))\n")), paragraph("scir.text"("Human overview:")), quote("scir.text"("> The cause is still open. An expired connection was reused, but that observation\n> does not yet distinguish connection reuse from load as the explanation.")), paragraph("scir.text"("Do not compress this to `causes(connectionReuse, Regression)`. The shorter record\nwould discard attribution and uncertainty. Compactness is less duplicated meaning,\nnot fewer symbols at any cost."))), "scir.kw"(area(Documentation), document("skills/scir-migrate/references/cases.md"), level("2"), order("20"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "skills/scir-migrate/references/cases.md", "Research: preserve disagreement", "0441bfbf4d702dd3debd4a75e0ca14239a2d63c8b34a3a1be95415b328e400f1")), ownership(record), parent("scir.ref"(Doc_skills_scir_migrate_references_cases__Choose_what_belongs_underneath)), title("scir.text"("Research: preserve disagreement"))))
record(Doc_skills_scir_migrate_references_cases__A_rationale_may_remain_language, Skill, blocks(code(scir, "scir.text"("question(Q1, reconnectReads, \"Must clients observe their earlier writes after reconnecting?\")\ndependsOn(StorageDecision, Q1)\n")), paragraph("scir.text"("The prose question already communicates its nuance. Its identity and relation to\na pending decision are what need structure. `StorageDecision` must resolve under\na reference-checking project contract; the fragment alone makes no such claim."))), "scir.kw"(area(Documentation), document("skills/scir-migrate/references/cases.md"), level("2"), order("30"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "skills/scir-migrate/references/cases.md", "A rationale may remain language", "0441bfbf4d702dd3debd4a75e0ca14239a2d63c8b34a3a1be95415b328e400f1")), ownership(record), parent("scir.ref"(Doc_skills_scir_migrate_references_cases__Choose_what_belongs_underneath)), title("scir.text"("A rationale may remain language"))))
record(Doc_skills_scir_migrate_references_cases__Source_ownership_and_review, Skill, blocks(paragraph("scir.text"("Start with the selected Markdown as the authority. Prepare a scoped SCIR proposal\nwith citations to a preserved snapshot. Review conditions, numbers, units, negation,\nstatus, and identity before transferring ownership of particular commitments.")), paragraph("scir.text"("After that transfer, source notes are historical evidence, the designated SCIR\nrecords own the working detail, and human prose explains the relevant part.\nAuthored prose can contribute new decisions too; reconcile those intentionally.\nDo not resolve disagreements by whichever file has the latest timestamp.")), paragraph("scir.text"("An authored overview can be edited for tone or structure without changing SCIR.\nA content change may call for a targeted prose review; it does not imply that prose\nmust be regenerated. References and hashes can flag review needs, not certify\narbitrary summaries as faithful.")), paragraph("scir.text"("When a requested contraction would discard an exception or unresolved question,\nretain it in the working content and make the omission explicit. Preserve original\nfiles until the owner accepts the migration; a passing shape check is not enough."))), "scir.kw"(area(Documentation), document("skills/scir-migrate/references/cases.md"), level("2"), order("40"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "skills/scir-migrate/references/cases.md", "Source ownership and review", "0441bfbf4d702dd3debd4a75e0ca14239a2d63c8b34a3a1be95415b328e400f1")), ownership(record), parent("scir.ref"(Doc_skills_scir_migrate_references_cases__Choose_what_belongs_underneath)), title("scir.text"("Source ownership and review"))))
