record(Doc_examples_knowledge_mathematics_source__Frozen_source, Source, "scir.text"("# Order argument\n\nS1: Let a, b, and c be real numbers.\nS2: Assume a <= b and b <= c.\nS3: Then a <= c by transitivity, using both inequalities.\nS4: Consequently max(a, c) = c, by the definition of maximum and the previous conclusion.\nS5: Strict inequality a < c is not established; equality remains possible.\n"), "scir.kw"(area(Documentation), document("examples/knowledge/mathematics/source.md"), level("0"), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/knowledge/mathematics/source.md", "Frozen source", "4af34631e9b3d79fa79e18794f2c9e2ac2b371100a9d9ba9ad17826cdc35a199")), ownership(record), sha256("4af34631e9b3d79fa79e18794f2c9e2ac2b371100a9d9ba9ad17826cdc35a199"), title("scir.text"("Frozen source"))))
