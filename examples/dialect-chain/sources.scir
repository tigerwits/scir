record(Doc_examples_dialect_chain_source__Frozen_source, Source, "scir.text"("# Parser requirements\n\nS1. If parsing fails, Parser must return Error.\nS2. If parsing fails, Parser must leave State unchanged.\nS3. Parser must never evaluate Payload.\nS4. The specification does not define a timeout policy.\n"), "scir.kw"(area(Documentation), document("examples/dialect-chain/source.md"), level("0"), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/dialect-chain/source.md", "Frozen source", c04efd69c0c30c0157c1bd07c6bcec574802871d315eeb0732a6bac2ebac18d8)), ownership(record), sha256(c04efd69c0c30c0157c1bd07c6bcec574802871d315eeb0732a6bac2ebac18d8), title("scir.text"("Frozen source"))))
