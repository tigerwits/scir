record(Doc_examples_dialect_chain_README__Dialect_refinement_chain, Guide, blocks(paragraph("scir.text"("Keep one source fixed. Add constraints, revise the representation, and inspect\nwhat changed. This is a worked example using **authored stage files**, not a model\nbenchmark.")), paragraph("scir.text"("From an installed checkout:")), code(bash, "scir.text"("python examples/dialect-chain/run.py\npython examples/dialect-chain/run.py --json\n")), paragraph("scir.text"("The first command shows acceptance and preservation checks. JSON adds occurrence\npaths, positional diffs, document sizes, fingerprints, and source-review results.\nNeither command rewrites the input files."))), "scir.kw"(area(Documentation), document("examples/dialect-chain/README.md"), level("1"), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/dialect-chain/README.md", "Dialect refinement chain", fcf4b38d125246379ee431cea541ba19a642aad354afc0016242bdf9a7cf7f90)), ownership(record), title("scir.text"("Dialect refinement chain"))))
record(Doc_examples_dialect_chain_README__Fixed_source, Guide, blocks(paragraph("scir.text"("[source.md](source.md) contains four statements:")), quote("scir.text"("> **S1.** If parsing fails, Parser must return Error.\n>\n> **S2.** If parsing fails, Parser must leave State unchanged.\n>\n> **S3.** Parser must never evaluate Payload.\n>\n> **S4.** The specification does not define a timeout policy.")), paragraph("scir.text"("The source SHA-256 is fixed in [contracts.py](contracts.py), along with an authored\nfour-term oracle. Changing the source requires a new review, not a silent update\nto make a candidate pass. The hash detects changes; it does not certify meaning."))), "scir.kw"(area(Documentation), document("examples/dialect-chain/README.md"), level("2"), links("scir.tuple"(link("source.md", "source.md"), link("contracts.py", "contracts.py"))), order("10"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/dialect-chain/README.md", "Fixed source", fcf4b38d125246379ee431cea541ba19a642aad354afc0016242bdf9a7cf7f90)), ownership(record), parent("scir.ref"(Doc_examples_dialect_chain_README__Dialect_refinement_chain)), title("scir.text"("Fixed source"))))
record(Doc_examples_dialect_chain_README__Four_representations, Guide, blocks, "scir.kw"(area(Documentation), document("examples/dialect-chain/README.md"), level("2"), order("20"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/dialect-chain/README.md", "Four representations", fcf4b38d125246379ee431cea541ba19a642aad354afc0016242bdf9a7cf7f90)), ownership(record), parent("scir.ref"(Doc_examples_dialect_chain_README__Dialect_refinement_chain)), title("scir.text"("Four representations"))))
record(Doc_examples_dialect_chain_README__0_Generic_draft, Guide, blocks(paragraph("scir.text"("[00-generic.scir](stages/00-generic.scir) uses informal vocabulary:")), code(scir, "scir.text"("must(Parser, when(parseFails, return(Error)))\nmust(Parser, when(parseFails, leaveUnchanged(State)))\nmustNot(Parser, evaluate(Payload))\nunspecified(timeoutPolicy(Parser))\n"))), "scir.kw"(area(Documentation), document("examples/dialect-chain/README.md"), level("3"), links("scir.tuple"(link("00-generic.scir", "stages/00-generic.scir"))), order("30"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/dialect-chain/README.md", "0. Generic draft", fcf4b38d125246379ee431cea541ba19a642aad354afc0016242bdf9a7cf7f90)), ownership(record), parent("scir.ref"(Doc_examples_dialect_chain_README__Four_representations)), title("scir.text"("0. Generic draft"))))
record(Doc_examples_dialect_chain_README__1_Shared_vocabulary, Guide, blocks(paragraph("scir.text"("[01-vocabulary.scir](stages/01-vocabulary.scir) adopts agreed argument roles:")), code(scir, "scir.text"("requires(Parser, on(failure(Parse), return(Error)))\nrequires(Parser, on(failure(Parse), unchanged(State)))\nforbids(Parser, evaluate(Payload))\nunspecified(timeoutPolicy(Parser))\n")), paragraph("scir.text"("`requires(component, on(condition, effect))` records a conditional obligation.\n`forbids(component, evaluate(payload))` records a prohibition. Neither asserts\nthat parsing failed or that the implementation meets the requirement.")), paragraph("scir.text"("The first dialect permits these statement shapes plus optional `record`,\n`condition`, `ref`, and `timeout` forms. Later dialects **require** some of them;\nthey do not add forms forbidden earlier. Leaf identifiers remain open."))), "scir.kw"(area(Documentation), document("examples/dialect-chain/README.md"), level("3"), links("scir.tuple"(link("01-vocabulary.scir", "stages/01-vocabulary.scir"))), order("40"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/dialect-chain/README.md", "1. Shared vocabulary", fcf4b38d125246379ee431cea541ba19a642aad354afc0016242bdf9a7cf7f90)), ownership(record), parent("scir.ref"(Doc_examples_dialect_chain_README__Four_representations)), title("scir.text"("1. Shared vocabulary"))))
record(Doc_examples_dialect_chain_README__2_Named_records, Guide, blocks(paragraph("scir.text"("[02-records.scir](stages/02-records.scir) wraps statements in uniquely named records:")), code(scir, "scir.text"("record(R1, requires(Parser, on(failure(Parse), return(Error))))\nrecord(R2, requires(Parser, on(failure(Parse), unchanged(State))))\nrecord(R3, forbids(Parser, evaluate(Payload)))\nrecord(R4, unspecified(timeoutPolicy(Parser)))\n")), paragraph("scir.text"("A declaration ID must be a leaf. Record and condition IDs share one namespace.\nAt least one record is required; condition declarations may remain separate roots."))), "scir.kw"(area(Documentation), document("examples/dialect-chain/README.md"), level("3"), links("scir.tuple"(link("02-records.scir", "stages/02-records.scir"))), order("50"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/dialect-chain/README.md", "2. Named records", fcf4b38d125246379ee431cea541ba19a642aad354afc0016242bdf9a7cf7f90)), ownership(record), parent("scir.ref"(Doc_examples_dialect_chain_README__Four_representations)), title("scir.text"("2. Named records"))))
record(Doc_examples_dialect_chain_README__3_Checked_references, Guide, blocks(paragraph("scir.text"("[03-references.scir](stages/03-references.scir) names the shared failure condition:")), code(scir, "scir.text"("condition(C1, failure(Parse))\nrecord(R1, requires(Parser, on(ref(C1), return(Error))))\nrecord(R2, requires(Parser, on(ref(C1), unchanged(State))))\nrecord(R3, forbids(Parser, evaluate(Payload)))\nrecord(R4, unspecified(timeoutPolicy(Parser)))\n")), paragraph("scir.text"("Conditional requirements must reference a uniquely declared condition. Forward\nreferences work. A reference to a record, a missing ID, an ambiguous declaration,\nor an unused condition fails. Definitions cannot contain references or cycles.")), paragraph("scir.text"("Here `condition` names a description; it is not evidence that the condition holds.\nThese conventions belong to this example, not to SCIR Core."))), "scir.kw"(area(Documentation), document("examples/dialect-chain/README.md"), level("3"), links("scir.tuple"(link("03-references.scir", "stages/03-references.scir"))), order("60"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/dialect-chain/README.md", "3. Checked references", fcf4b38d125246379ee431cea541ba19a642aad354afc0016242bdf9a7cf7f90)), ownership(record), parent("scir.ref"(Doc_examples_dialect_chain_README__Four_representations)), title("scir.text"("3. Checked references"))))
record(Doc_examples_dialect_chain_README__Cumulative_checks, Guide, blocks(paragraph("scir.text"("Contracts are tuples of existing Python constraint functions. Each stage appends\nto the previous tuple. On the shipped documents the runner produces:")), table(row("scir.text"(Document), "scir.text"(Generic), "scir.text"(Vocabulary), "scir.text"(Records), "scir.text"(References), "scir.text"("Concrete timeout")), row("scir.text"("Generic draft"), "scir.text"(pass), "scir.text"(fail), "scir.text"(fail), "scir.text"(fail), "scir.text"(fail)), row("scir.text"("Shared vocabulary"), "scir.text"(pass), "scir.text"(pass), "scir.text"(fail), "scir.text"(fail), "scir.text"(fail)), row("scir.text"("Named records"), "scir.text"(pass), "scir.text"(pass), "scir.text"(pass), "scir.text"(fail), "scir.text"(fail)), row("scir.text"("Checked references"), "scir.text"(pass), "scir.text"(pass), "scir.text"(pass), "scir.text"(pass), "scir.text"(fail))), paragraph("scir.text"("A prior draft is not malformed SCIR merely because it fails a stricter dialect.\nThe JSON report retains those failures instead of showing only the final success."))), "scir.kw"(area(Documentation), document("examples/dialect-chain/README.md"), level("2"), order("70"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/dialect-chain/README.md", "Cumulative checks", fcf4b38d125246379ee431cea541ba19a642aad354afc0016242bdf9a7cf7f90)), ownership(record), parent("scir.ref"(Doc_examples_dialect_chain_README__Dialect_refinement_chain)), title("scir.text"("Cumulative checks"))))
record(Doc_examples_dialect_chain_README__Preservation_is_a_separate_check, Guide, blocks(paragraph("scir.text"("Three explicit operations connect the authored stages:")), code(text, "scir.text"("translate_draft(d0) = d1\nunrecord(d2) = d1\ninline_conditions(d3) = d2\n")), paragraph("scir.text"("The first uses four reviewed whole-statement mappings. It does not automatically\nrewrite synonyms elsewhere. The other operations are structural projections:\nremove record wrappers; or inline validated condition references and remove their\ndeclarations. They operate only at the declared statement positions, not under\narbitrary heads. Their composed projection reconstructs the vocabulary stage.")), paragraph("scir.text"("`source_review` compares projected statements to the authored oracle **with\nmultiplicity**. It catches lost, added, and duplicated commitments. Source statement\norder is ignored by that comparison; the exact projection checks still preserve\norder. Neither check proves faithful English translation. Unknown draft wordings\nor unsupported reference structures can be unreviewable rather than wrong.")), paragraph("scir.text"("Every report carries the source hash, checker-source hash, stage content digests,\napplied rule names, and source-review status. Fixed structural questions extract\nthe state-change guard, payload prohibition, missing timeout, and failure effects\nfrom each reviewed view. They inspect recorded obligations, not runtime behavior.\nIt reports characters, not tokens.\nA changed representation needs fresh annotations; paths are snapshot-local."))), "scir.kw"(area(Documentation), document("examples/dialect-chain/README.md"), level("2"), order("80"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/dialect-chain/README.md", "Preservation is a separate check", fcf4b38d125246379ee431cea541ba19a642aad354afc0016242bdf9a7cf7f90)), ownership(record), parent("scir.ref"(Doc_examples_dialect_chain_README__Dialect_refinement_chain)), title("scir.text"("Preservation is a separate check"))))
record(Doc_examples_dialect_chain_README__A_refinement_that_must_stop, Guide, blocks(paragraph("scir.text"("The next contract requires exactly one concrete Parser timeout, such as a positive\ninteger duration label ending in `ms`, `s`, or `m`. It also rejects an unspecified\nParser timeout. The last faithful fixture fails it because **S4 supplies no value**.")), paragraph("scir.text"("[unsupported-timeout.scir](counterexamples/unsupported-timeout.scir) replaces R4 with:")), code(scir, "scir.text"("record(R4, timeout(Parser, \"30s\"))\n")), paragraph("scir.text"("It passes the target dialect but fails source review: S4 disappeared and a new\ntimeout was introduced. This witnesses a nonempty target dialect, not a faithful\nrefinement. A new timeout needs an author decision and a new source version.\nValidation must not invent it or weaken the contract to make the chain complete.\nThe stop is justified by this fixed source and reviewed conventions, not by a\ngeneral satisfiability solver."))), "scir.kw"(area(Documentation), document("examples/dialect-chain/README.md"), level("2"), links("scir.tuple"(link("unsupported-timeout.scir", "counterexamples/unsupported-timeout.scir"))), order("90"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/dialect-chain/README.md", "A refinement that must stop", fcf4b38d125246379ee431cea541ba19a642aad354afc0016242bdf9a7cf7f90)), ownership(record), parent("scir.ref"(Doc_examples_dialect_chain_README__Dialect_refinement_chain)), title("scir.text"("A refinement that must stop"))))
record(Doc_examples_dialect_chain_README__Try_other_translations, Guide, blocks(paragraph("scir.text"("Keep the source and contracts fixed. Put four candidate files with the same names\nas [stages](stages) in another folder, then run:")), code(bash, "scir.text"("python examples/dialect-chain/run.py --stages /path/to/trial --json\n")), paragraph("scir.text"("Exit codes: **0** means all worked-example checks passed, including the expected\nblocked target; **1** means review is needed; **2** means checking did not complete.\nA passing run never means the concrete-timeout target was met faithfully.")), paragraph("scir.text"("New wording can fall outside the small authored oracle. Review such cases\nindependently; do not count them as semantic failures or train the translator to\ncopy the expected tree. See the [experiment protocol](../../docs/research/README.md#dialect-chain-trials)\nfor direct, progressive, repeated-repair, and order-of-constraints comparisons.\nThe [theory](../../docs/theory.md#dialect-refinement-chains) separates nested accepted\nsets from translation paths. This folder is an example, not a new public API."))), "scir.kw"(area(Documentation), document("examples/dialect-chain/README.md"), level("2"), links("scir.tuple"(link(stages, stages), link("experiment protocol", "../../docs/research/README.md#dialect-chain-trials"), link(theory, "../../docs/theory.md#dialect-refinement-chains"))), order("100"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/dialect-chain/README.md", "Try other translations", fcf4b38d125246379ee431cea541ba19a642aad354afc0016242bdf9a7cf7f90)), ownership(record), parent("scir.ref"(Doc_examples_dialect_chain_README__Dialect_refinement_chain)), title("scir.text"("Try other translations"))))
record(Doc_examples_knowledge_README__Working_knowledge_readable_explanations, Guide, blocks(paragraph("scir.text"("The overview is for a person arriving at the project. The SCIR holds the working\ndetail an agent needs to continue it: assumptions, reasons, evidence, rejected\nproposals, and open questions. Neither has to be a mechanical copy of the other.")), paragraph("scir.text"("Each case contains three authored artifacts:")), code(text, "scir.text"("source.md       frozen source notes, with sentence anchors\nknowledge.scir  reviewed structural interpretation and dependencies\noverview.md     a short explanation written for a human\n")), paragraph("scir.text"("The overviews are **not generated**. There is no renderer or byte-equality test\nfor them. They may reorganize or omit working detail without dropping that detail\nfrom the maintained knowledge. Significant new commitments need reconciliation,\nnot an automatic overwrite in either direction."))), "scir.kw"(area(Documentation), document("examples/knowledge/README.md"), level("1"), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/knowledge/README.md", "Working knowledge, readable explanations", "1b5245f84d7725eab8555ac5d160a097471a8f9b2668efe7fe3e9de3c7213c70")), ownership(record), title("scir.text"("Working knowledge, readable explanations"))))
record(Doc_examples_knowledge_README__Three_cases, Guide, blocks(table(row("scir.text"(Case), "scir.text"("Human explanation"), "scir.text"("What remains in SCIR")), row("scir.text"("[Event-store recovery](architecture/overview.md)"), "scir.text"("Recovery direction and outstanding decisions."), "scir.text"("A determinism assumption, precise obligations, an unapproved proposal, and its dependencies.")), row("scir.text"("[Checkout incident](investigation/overview.md)"), "scir.text"("The cause remains unresolved; restart needs approval."), "scir.text"("Attributed observations and hypotheses, insufficient evidence, an earlier proposal, and its withdrawal.")), row("scir.text"("[Order argument](mathematics/overview.md)"), "scir.text"("Why the maximum is c, without claiming strict inequality."), "scir.text"("Domain, premises, conclusions, their limitation, and review dependencies."))), paragraph("scir.text"("These are authored fixtures, not recorded agent trials. Local role and payload\nmeanings are stated in the source notes; none becomes SCIR Core vocabulary."))), "scir.kw"(area(Documentation), document("examples/knowledge/README.md"), level("2"), links("scir.tuple"(link("Event-store recovery", "architecture/overview.md"), link("Checkout incident", "investigation/overview.md"), link("Order argument", "mathematics/overview.md"))), order("10"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/knowledge/README.md", "Three cases", "1b5245f84d7725eab8555ac5d160a097471a8f9b2668efe7fe3e9de3c7213c70")), ownership(record), parent("scir.ref"(Doc_examples_knowledge_README__Working_knowledge_readable_explanations)), title("scir.text"("Three cases"))))
record(Doc_examples_knowledge_README__Query_the_detail_you_need, Guide, blocks(paragraph("scir.text"("From an installed checkout:")), code(bash, "scir.text"("python examples/knowledge/run.py\npython -m scir query examples/knowledge/architecture/knowledge.scir --pattern 'record(?id, Assumption, ?content)'\npython -m scir query examples/knowledge/investigation/knowledge.scir --pattern 'record(?id, Hypothesis, ?content)'\npython examples/knowledge/run.py --case mathematics --changed A2\n")), paragraph("scir.text"("The last command returns review candidates `A2`, `C1`, `C2`, and `L1`: both\nconclusions and the limitation depend on that premise. Strengthening `b <= c`\nto `b < c` would establish `a < c`, so the old limitation also needs review.\nThe helper changes no files and makes no truth judgment. An incomplete\ndependency graph can miss relevant work; reachability only follows declared links.")), paragraph("scir.text"("The explicit rule is: a changed record needs review; if X depends on a record\nneeding review, X needs review too. The helper computes the least fixed point of\nthat rule, even with cycles, and returns IDs in document order. This is a small\nexample of deterministic reasoning **under a declared rule**, not built-in\nlogical inference by `query` or a proof checker for the mathematical argument."))), "scir.kw"(area(Documentation), document("examples/knowledge/README.md"), level("2"), order("20"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/knowledge/README.md", "Query the detail you need", "1b5245f84d7725eab8555ac5d160a097471a8f9b2668efe7fe3e9de3c7213c70")), ownership(record), parent("scir.ref"(Doc_examples_knowledge_README__Working_knowledge_readable_explanations)), title("scir.text"("Query the detail you need"))))
record(Doc_examples_knowledge_README__The_local_migration_contract, Guide, blocks(paragraph("scir.text"("Four root forms are sufficient here:")), code(scir, "scir.text"("snapshot(\"source-byte SHA-256\")\nrecord(P1, Proposal, unapproved(recover(checkpointThenSuffix)))\nsource(P1, S4)\ndependsOn(P1, A1)\n")), paragraph("scir.text"("That fragment illustrates forms, not a complete conforming document. The supplied\nchecker requires one exact SHA-256 for `source.md`, unique leaf record IDs, known\nrole leaves, valid source anchors and dependency references, and no duplicate\nlinks. Forward references are accepted. Payloads stay open.")), paragraph("scir.text"("`source.md` uses explicit `S1: ...` lines; this is an example convention, not a\nMarkdown parser. Every marked sentence needs a link, and every record needs at\nleast one source link. One sentence may support several records. These are\n**bookkeeping checks**: they cannot establish that a cited sentence supports a\nparticular translation. A wrong conclusion with a valid citation can still pass.\nRead the source and proposed interpretation together.")), paragraph("scir.text"("Dependencies are authored review relationships. Equal labels elsewhere are not\nautomatically references, and cycles are allowed. Their closure is temporary\nquery output, not another maintained copy of the knowledge.")), paragraph("scir.text"("After changing the source, the old byte hash fails. Review the affected records\nbefore updating that hash. Rehashing alone establishes neither fidelity nor a\ncompleted migration. After handoff, the original source remains historical;\nit must not silently override subsequently approved knowledge changes.")), paragraph("scir.text"("The runner checks canonical SCIR and the local contract. Exit **0** means those\nchecks completed, **1** means rejection, and **2** means checking could not\ncomplete. Authored overviews and domain truth are outside its acceptance claim.\nIt never installs packages, imports source-provided rules, executes payloads,\nrewrites prose, or changes source notes."))), "scir.kw"(area(Documentation), document("examples/knowledge/README.md"), level("2"), order("30"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/knowledge/README.md", "The local migration contract", "1b5245f84d7725eab8555ac5d160a097471a8f9b2668efe7fe3e9de3c7213c70")), ownership(record), parent("scir.ref"(Doc_examples_knowledge_README__Working_knowledge_readable_explanations)), title("scir.text"("The local migration contract"))))
record(Doc_examples_knowledge_README__Try_a_maintenance_change, Guide, blocks(paragraph("scir.text"("In a scratch copy, remove `A2` from the mathematical records: the `dependsOn`\nreference fails. Keep the record but revise its premise: references may still\npass, while the conclusions need mathematical review. Editing the overview alone\ndoes not alter the premises or generate a false fidelity certificate.")), paragraph("scir.text"("For real projects, use the [migration skill](../../skills/scir-migrate/SKILL.md).\nKeep your own vocabulary and acceptance policy; this four-form dialect is an\nexample, not a mandatory knowledge schema."))), "scir.kw"(area(Documentation), document("examples/knowledge/README.md"), level("2"), links("scir.tuple"(link("migration skill", "../../skills/scir-migrate/SKILL.md"))), order("40"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/knowledge/README.md", "Try a maintenance change", "1b5245f84d7725eab8555ac5d160a097471a8f9b2668efe7fe3e9de3c7213c70")), ownership(record), parent("scir.ref"(Doc_examples_knowledge_README__Working_knowledge_readable_explanations)), title("scir.text"("Try a maintenance change"))))
record(Doc_examples_consumer_lifecycle_README__Consumer_lifecycle_example, Guide, blocks(paragraph("scir.text"("This example adds trusted application rules to ordinary `working/1` records.\nIt does not add a policy engine, execute a represented action, or connect to a\nservice. All approvals and receipts are fixed test doubles. They are not evidence\nthat a real test or delivery occurred.")), paragraph("scir.text"("From an approved installed checkout, run:")), code(sh, "scir.text"("python examples/consumer-lifecycle/run.py\n")), paragraph("scir.text"("The command reads `notes.scir`. It resolves a declared replacement, rejects an\nunsafe status update, prepares a ready candidate, and checks completion evidence.\nIt rejects an old snapshot and delivers complete selected context. It prints a\nJSON report and leaves the source unchanged. The example also runs after relocation\nand from the source distribution outside the repository."))), "scir.kw"(area(Documentation), document("examples/consumer-lifecycle/README.md"), level("1"), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/consumer-lifecycle/README.md", "Consumer lifecycle example", "83f6adf29af27fbedf72f6ebe2e5e022f5c0be5ecd5fa7c3bc88c3d58f022b08")), ownership(record), title("scir.text"("Consumer lifecycle example"))))
record(Doc_examples_consumer_lifecycle_README__Consumer_contract, Guide, blocks(paragraph("scir.text"("`policy.py` owns this example's trusted rules. The canonical `notes.scir` owns its\nhypothetical records. `run.py` supplies fixed approvals and receipts from a test\nfixture, not from the candidate being checked. Do not use these fixture identities\nas live credentials or derive new trusted approvals from user-authored records.")), paragraph("scir.text"("The example has a deliberately small contract:")), table(row("scir.text"(Kind), "scir.text"(Rule)), row("scir.text"(Decision), "scir.text"("Exact sender, recipient and document; explicit staging scope; proposed or approved status")), row("scir.text"(Recovery), "scir.text"("Preserve the uncertain-outcome condition, original key and lookup-before-retry order")), row("scir.text"(Evidence), "scir.text"("Explicit decision, scope, receipt ID, operation and outcome coordinates")), row("scir.text"(Task), "scir.text"("Exact action and scope; declared decision and recovery prerequisites; blocked, ready or completed status")), row("scir.text"(Note), "scir.text"("Inert supporting text; it does not approve an action"))), paragraph("scir.text"("A ready task must point directly to the resolved decision. It must retain both\nprerequisites and a passing test receipt for that exact decision and scope.\nA completed task also needs a matching delivery receipt. An approved decision's\ncomplete record fingerprint must occur in the separate trusted approval set.\nChanging approved content thus requires new approval and matching evidence.")), paragraph("scir.text"("Evidence records are claims. The consumer compares their coordinates with the\nseparate `TrustedInputs` object. A matching label alone is insufficient. The\nexample does not authenticate signatures or execute tests; a production host must\nobtain and verify those inputs from its trusted source. The supplied mappings are\ncopied and immutable during a call. The host must separately guard its revision,\nauthority and receipt state when persisting a proposal.")), paragraph("scir.text"("The checker rejects unknown kinds/fields, wrong roles, lost scope, missing\nprerequisites, changed recovery keys/order and unsupported completion. Generic\nSCIR can represent these invalid commitments; the consumer decides whether its\nown contract permits them. Both permitted and forbidden cases have tests.")), paragraph("scir.text"("`propose_checked` first constructs a snapshot-guarded generic candidate. It then\nchecks the whole candidate against the consumer contract. It does not return a\npartially accepted change. A valid candidate remains a proposal, not permission\nto submit an action or overwrite a shared source."))), "scir.kw"(area(Documentation), document("examples/consumer-lifecycle/README.md"), level("2"), order("10"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/consumer-lifecycle/README.md", "Consumer contract", "83f6adf29af27fbedf72f6ebe2e5e022f5c0be5ecd5fa7c3bc88c3d58f022b08")), ownership(record), parent("scir.ref"(Doc_examples_consumer_lifecycle_README__Consumer_lifecycle_example)), title("scir.text"("Consumer contract"))))
record(Doc_examples_consumer_lifecycle_README__Effective_state_query, Guide, blocks(paragraph("scir.text"("`effective(index, id, scope=STAGING)` is an example query, not a new runtime API.\nIt follows incoming `supersedes` links among decisions. Generic `select()` still\nfollows outgoing references and retains historical records.")), paragraph("scir.text"("The query returns one explicit status:")), table(row("scir.text"(Status), "scir.text"(Meaning)), row("scir.text"("`resolved`"), "scir.text"("One terminal decision has declared approved status in the requested scope")), row("scir.text"("`unapproved`"), "scir.text"("The one terminal decision is not declared approved")), row("scir.text"("`competing`"), "scir.text"("More than one terminal replacement exists")), row("scir.text"("`cycle`"), "scir.text"("A reachable replacement cycle prevents a terminal answer")), row("scir.text"("`scope-mismatch`"), "scir.text"("A reachable record has a different or missing scope"))), paragraph("scir.text"("This strict example reports a scope mismatch before other lineage questions.\nIt does not ignore a competing branch, select by timestamp, or erase an old\nrecord. A proposed intermediate record may precede an approved terminal record.\nUnknown IDs and wrong target kinds fail; more than 256 records exceeds the\nexample's explicit bound. Iterative traversal terminates on cycles.")), paragraph("scir.text"("`resolved` describes the represented lineage. The task checker still verifies\nexternal approval and receipt inputs. It is not a claim that the decision is true\nor a general rule for every consumer's definition of current state."))), "scir.kw"(area(Documentation), document("examples/consumer-lifecycle/README.md"), level("2"), order("20"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/consumer-lifecycle/README.md", "Effective-state query", "83f6adf29af27fbedf72f6ebe2e5e022f5c0be5ecd5fa7c3bc88c3d58f022b08")), ownership(record), parent("scir.ref"(Doc_examples_consumer_lifecycle_README__Consumer_lifecycle_example)), title("scir.text"("Effective-state query"))))
record(Doc_examples_consumer_lifecycle_README__Verification_and_limits, Guide, blocks(paragraph("scir.text"("`tests/test_consumer_lifecycle.py` covers permitted candidates, policy violations,\nreceipt substitution, stale changes, lineage conflicts, bounds and relocation.\nThe runner also executes with Python assertions disabled. No test here establishes\nmodel behavior, authentic remote execution or concurrent persistent commit safety.")), paragraph("scir.text"("Use the host's atomic precondition/write operation for real persistence. Do not\nreplace that operation with a check followed by an unguarded file write. The\n[workflow tools](../../docs/workflow-tools.md) keep complete context separate from\nproposal deltas; the [repository handoff](../../spec/HANDOFF.md) retains file bases\nand source-owned plans. Those interfaces do not supply the missing host authority."))), "scir.kw"(area(Documentation), document("examples/consumer-lifecycle/README.md"), level("2"), links("scir.tuple"(link("workflow tools", "../../docs/workflow-tools.md"), link("repository handoff", "../../spec/HANDOFF.md"))), order("30"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/consumer-lifecycle/README.md", "Verification and limits", "83f6adf29af27fbedf72f6ebe2e5e022f5c0be5ecd5fa7c3bc88c3d58f022b08")), ownership(record), parent("scir.ref"(Doc_examples_consumer_lifecycle_README__Consumer_lifecycle_example)), title("scir.text"("Verification and limits"))))
record(Doc_examples_consumer_lifecycle_README__Named_dialect_and_result_handoff, Guide, blocks(paragraph("scir.text"("The primary `run.py` workflow uses named contract `consumer-lifecycle/2`.\nThe `structured` stage gates one consumer stage. That stage builds one immutable\nworking Index, then applies the existing `policy.check` function. Its field,\nreference-kind and conditional rules have one owner; they are not repeated in\nseparate stages. Invalid working data cannot reach the consumer policy.")), paragraph("scir.text"("The old `dialect_run.py` entry point is a thin compatibility view of the same run,\nnot a second workflow to maintain or execute. Its result identifies version 2.\nGeneral helper composition remains covered by the public API examples and tests.\nThe scheduling/diagnostic layout is an explicit example-contract revision, not\na change to the generic dialect engine.")), paragraph("scir.text"("The host converts its fixed `TrustedInputs` into a separate immutable Context.\nIts revision and exact contents are bound to each result. The example rejects an\nold context guard even when the SCIR document did not change. Malformed host\ncontext yields incomplete validation, not a claim that the candidate is false.\nA checked proposal returns the complete generic candidate and a conforming result;\nfailed or incomplete policy cannot return a successfully checked candidate.")), paragraph("scir.text"("A result for the full collection is not copied onto a selected subset. The runner\nchecks the subset again. The regression tests include a consumer requiring an\nindependent record that reference closure omits. Callers must not assume arbitrary\ndialects are preserved by selection, concatenation or editing. Source and service\nwrites still require the host's atomic guards. All receipt inputs remain test doubles."))), "scir.kw"(area(Documentation), document("examples/consumer-lifecycle/README.md"), level("2"), order("40"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/consumer-lifecycle/README.md", "Named dialect and result handoff", "83f6adf29af27fbedf72f6ebe2e5e022f5c0be5ecd5fa7c3bc88c3d58f022b08")), ownership(record), parent("scir.ref"(Doc_examples_consumer_lifecycle_README__Consumer_lifecycle_example)), title("scir.text"("Named dialect and result handoff"))))
record(Doc_examples_knowledge_mathematics_overview__Why_the_maximum_is_c, Guide, blocks(paragraph("scir.text"("The two assumed inequalities put a no higher than c. That makes c the maximum\nof the pair. The argument does not give a strict inequality: a and c may be equal.")), paragraph("scir.text"("The [argument record](knowledge.scir) preserves the domain, each assumption,\nthe two conclusions, and the limitation they leave open. Its dependency graph\nhelps target review of conclusions and limitations when an assumption changes;\nit is not itself a machine-checked proof."))), "scir.kw"(area(Documentation), document("examples/knowledge/mathematics/overview.md"), level("1"), links("scir.tuple"(link("argument record", "knowledge.scir"))), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/knowledge/mathematics/overview.md", "Why the maximum is c", c881f77929f9aaaac1bc4b31e5cf978a4d4754c85218ec536a873d8b4a793d60)), ownership(record), title("scir.text"("Why the maximum is c"))))
record(Doc_examples_knowledge_investigation_overview__Checkout_cause_still_unresolved, Guide, blocks(paragraph("scir.text"("The timeout has two live explanations: stale pooled connections and database\noverload. The expired-connection trace is not enough to choose between them.")), paragraph("scir.text"("The immediate-restart proposal was withdrawn. Any restart still requires\non-call approval.")), paragraph("scir.text"("See [the investigation record](knowledge.scir) for attribution, trace references,\nand the retained proposal and withdrawal. These notes do not authorize an action."))), "scir.kw"(area(Documentation), document("examples/knowledge/investigation/overview.md"), level("1"), links("scir.tuple"(link("the investigation record", "knowledge.scir"))), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/knowledge/investigation/overview.md", "Checkout: cause still unresolved", "4694ada675c8a6b8b0cfd387a0198695b675cf5811c7b0785d18857c41452069")), ownership(record), title("scir.text"("Checkout: cause still unresolved"))))
record(Doc_examples_knowledge_architecture_overview__Recovering_the_event_store, Guide, blocks(paragraph("scir.text"("Recovery is built around the ordered event history. We are considering\ncheckpoints to shorten replay, but that recovery plan is not yet approved.\nA checkpoint from another event stream must be rejected. Compaction policy\nis still open.")), paragraph("scir.text"("The [working knowledge](knowledge.scir) keeps the exact obligations, the handler\nassumption, and the proposal's dependencies. Change those records when the design\nchanges; edit this overview for readers, not to mirror every record."))), "scir.kw"(area(Documentation), document("examples/knowledge/architecture/overview.md"), level("1"), links("scir.tuple"(link("working knowledge", "knowledge.scir"))), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "examples/knowledge/architecture/overview.md", "Recovering the event store", "07723bd4ce2da827cb4ef30a3204f704e924fb3b3dbe238297f65cf7d54f93de")), ownership(record), title("scir.text"("Recovering the event store"))))
