topic(OccurrencePaths, Queries)
wording(OccurrencePaths, "A path is a nonempty sequence `(root_index, child_index, ...)` of nonnegative integers. Python Booleans are not indices. Paths are local to a document snapshot.")
topic(OccurrenceWalk, Queries)
wording(OccurrenceWalk, "Walking enumerates every occurrence in root-order, depth-first preorder.")
topic(RootScope, Queries)
wording(RootScope, "Queries default to matching roots.")
topic(NestedScope, Queries)
wording(NestedScope, "Explicit `scope=\"all\"` matches every occurrence.")
topic(QueryResults, Queries)
wording(QueryResults, "Results include path, matched term, and bindings, in traversal order, including duplicate occurrences.")
topic(QueryInference, Queries)
wording(QueryInference, "Neither scope computes logical consequences.")
note(QueryResults, "`query(document, pattern, *, scope=\"roots\")` returns a list of `Hit(path, term, bindings)` records. `Hit` lives in `scir.tree`. A Hit's bindings are a caller-owned dictionary, not a recursively frozen map.")
note(QueryInference, "Finding `use(Alice, Data)` inside `think(Bob, ...)` does not establish that it happened. The matched path retains its enclosing context; root matches are not necessarily facts either.")
queryExample(DefaultScope, RootScope, input(think(Bob, use(Alice, Data))), "use(Alice, ?data)", default, paths)
queryExample(NestedMatch, NestedScope, input(think(Bob, use(Alice, Data))), "use(Alice, ?data)", all, paths(path("0", "1")))
queryExample(DuplicateMatches, QueryResults, input(f(A, A), f(A, A)), A, all, paths(path("0", "0"), path("0", "1"), path("1", "0"), path("1", "1")))
