record(Doc_proofs_README__Profile_law_model, Evidence, blocks(paragraph("scir.text"("`ProfileLaws.lean` is a separate model checked with Lean 4.19.0 and no mathlib.\nFrom this folder with that toolchain installed, run `lean ProfileLaws.lean`.\nCI compiles it with warnings as errors and prints the assumptions of each named\ntheorem. Lean is a verification dependency only; the Python package does not load\nor install it. The fixed upstream release is downloaded in the verification job;\nits archive checksum and `lean --version` are recorded in that job's logs.")), paragraph("scir.text"("The closure model proves seed inclusion, monotonicity, least closed-set membership\nand idempotence. `Reach` follows explicit edges, which may represent references\nor reversed dependencies. It does not infer undeclared edges or factual truth.\nThe raw-tree model proves tuple and reference constructor injectivity and three\nspecific distinctions: text versus reference, two arguments versus one tuple\nargument, and a named role versus a positional role-shaped application.")), paragraph("scir.text"("These are checked logical model theorems, NOT a proof of the Python implementation,\nparser, UTF-8 codecs, field sorting, source translation, resource bounds or database\nconcurrency. Ordered output/reasons and bounded failures are tested in Python.\nFinite visited-set traversal terminates because each finite record ID is queued\nonce; the executable implementation is compared with an independently implemented\nfixed-point oracle on all three-node graphs and every seed set.")), paragraph("scir.text"("No admission is used in this source. CI rejects admissions before invoking Lean\nand rejects unexpected assumptions afterward. The model deliberately contains no\nruntime evaluator, type inference system or persistence state machine."))), "scir.kw"(area(Documentation), document("proofs/README.md"), level("1"), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "proofs/README.md", "Profile law model", "5c60deeacea59de8af8a4c87cbb1ceb97c57781a2025e615a75a25f3188468d3")), ownership(record), title("scir.text"("Profile law model"))))
record(Doc_docs_profile_results__Profile_implementation_verification_and_measured_costs, Evidence, blocks(paragraph("scir.text"("Date: 2026-10-02. Package 1.1.0 source implementation; native content format 1.0.\nNo release or package publication follows from these implementation changes."))), "scir.kw"(area(Documentation), document("docs/profile-results.md"), level("1"), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/profile-results.md", "Profile implementation: verification and measured costs", "1af2b6d6c2e386432fe815d67cbd76f8cbe49ccef3b618bb472820258221d3f6")), ownership(record), title("scir.text"("Profile implementation: verification and measured costs"))))
record(Doc_docs_profile_results__Reproducible_evidence, Evidence, blocks(paragraph("scir.text"("The first successful Profile verification run is\n[37005279184](https://github.com/tigerwits/scir/actions/runs/37005279184), at PR head\n`2272313372cacb68b4f2790e1d16b5da1b74e682`. GitHub tested its merge with base\n`b7bf167cb3873d0bf65930ffe5e6418391ba0e9f` as\n`734d8a4138b6e5fe982e5c3c4602724f6dd687b3`.")), paragraph("scir.text"("All five profile jobs passed: integration/packaging on Linux, macOS and Windows,\nthe Lean model, and the executable law/measurement job. At that same head, the\nseparate full original Check workflow exposed two integration problems: a stale\npackage-version assertion and a 167-character skill description exceeding the\nexisting 160-character limit. Follow-up changes update the package assertion to\n1.1.0 while retaining the exact format-1.0 assertions, and shorten the description\nwithout weakening its limit. Do not interpret the first profile run as proof that\nthe original full suite passed; final exact-head gates are recorded on PR #7.")), paragraph("scir.text"("The measured production modules, corpus and evaluation driver are unchanged by\nthose metadata fixes and by the subsequent report/checksum-pinning changes.\nEvidence job `110831986458` ran CPython 3.12.14 with tiktoken 0.12.0 and measured\n`o200k_base` and `cl100k_base`. Those identify encodings, not current models.\n[Artifact 11225292581](https://github.com/tigerwits/scir/actions/runs/37005279184/artifacts/11225292581)\ncontains fifteen files: four complete information-matched representations, nine\nworkflow payloads, results JSON and a representation CSV. Its ZIP SHA-256 is\n`7687514962413d5b22dd72f149f4fd0489056cfd0341dd3c617b83c04dfb830b`.\nRetention is 90 days, not permanent. The generator, fixtures, protocol and selected\nobservations remain in Git. This report transcribes observed CI output, not an\nindependent rerun or an agent trial.")), paragraph("scir.text"("Reproduce with the installed project interpreter:")), code(sh, "scir.text"("python tools/check_profile_laws.py\npython tools/study_profiles.py --tokens --output .build/profile-evaluation\npython examples/working-profile/run.py\n")), paragraph("scir.text"("The token option requires the pinned optional measurement dependency. Output paths\nmust be fresh. Without it, only actual UTF-8 bytes are reported; no token estimates.\nThe complete result includes source/code hashes and profile/content identities."))), "scir.kw"(area(Documentation), document("docs/profile-results.md"), level("2"), links("scir.tuple"(link("37005279184", "https://github.com/tigerwits/scir/actions/runs/37005279184"), link("Artifact 11225292581", "https://github.com/tigerwits/scir/actions/runs/37005279184/artifacts/11225292581"))), order("10"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/profile-results.md", "Reproducible evidence", "1af2b6d6c2e386432fe815d67cbd76f8cbe49ccef3b618bb472820258221d3f6")), ownership(record), parent("scir.ref"(Doc_docs_profile_results__Profile_implementation_verification_and_measured_costs)), title("scir.text"("Reproducible evidence"))))
record(Doc_docs_profile_results__Structural_verification, Evidence, blocks(paragraph("scir.text"("The executable finite model covers all 512 directed graphs on three record IDs\nand all eight seed subsets: 4,096 cases. It checks selection against a separate\nfixed-point oracle, reverse-dependency impact, seed inclusion, idempotence,\nmonotonicity and least closed-superset membership. Generated notation tests also\nexercise 400 structured print/parse roundtrips, lexical renaming, nesting and\ncombined alias/operator/role/tuple cases. These finite checks are not universal\nproofs of the Python implementation.")), paragraph("scir.text"("The separate Lean 4.19.0 model compiled successfully in job `110831986768`.\nFour closure theorems use no axioms; five constructor/distinction theorems report\nonly Lean's propositional extensionality (`propext`). There are no admissions or\ncustom axioms. The model covers seed inclusion, monotonicity, least closed-set\nmembership, idempotence, tuple/reference injectivity, text/reference separation,\ncall arity versus a packed tuple, and named versus positional role structure.\nIt does not prove Python parsing, canonical UTF-8, field sorting, resource limits,\nsource fidelity, or persistent concurrency. See [proof scope](../proofs/README.md).")), paragraph("scir.text"("The verified release archive's SHA-256 is\n`6fe3ce97a58f44e2b3567d455b994eacec5bfe9ae7774f2a573444480ba813fe`.\nCI now requires that checksum before extraction, rather than merely recording it.\nLean remains a verification dependency, not a Python runtime dependency.")), paragraph("scir.text"("Cross-platform packaging checks build a wheel and source distribution, rebuild\na second wheel from the source archive outside the checkout, compare package\nmember bytes, and exercise both installed copies outside the checkout. Profile\nCLI tests preserve source files and check UTF-8 output under an ASCII terminal.\nNative core/parser/matching/traversal/transport byte sentinels protect the baseline."))), "scir.kw"(area(Documentation), document("docs/profile-results.md"), level("2"), links("scir.tuple"(link("proof scope", "../proofs/README.md"))), order("20"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/profile-results.md", "Structural verification", "1af2b6d6c2e386432fe815d67cbd76f8cbe49ccef3b618bb472820258221d3f6")), ownership(record), parent("scir.ref"(Doc_docs_profile_results__Profile_implementation_verification_and_measured_costs)), title("scir.text"("Structural verification"))))
record(Doc_docs_profile_results__Information_matched_representation_costs, Evidence, blocks(paragraph("scir.text"("Twenty implementer-authored synthetic records are represented by four lossless\nencodings. The compact JSON baseline is a tree encoding, not an optimized JSON\nrecord schema. No translation from unrestricted English is evaluated.")), table(row("scir.text"(Representation), "scir.text"("UTF-8 bytes"), "scir.text"("o200k body"), "scir.text"("cl100k body"), "scir.text"("o200k body + guide")), row("scir.text"("Native tagged SCIR"), "scir.text"("2947"), "scir.text"("744"), "scir.text"("748"), "scir.text"("780")), row("scir.text"("Compact JSON trees"), "scir.text"("3615"), "scir.text"("1050"), "scir.text"("1054"), "scir.text"("1081")), row("scir.text"("Explicit notation, no aliases"), "scir.text"("2631"), "scir.text"("612"), "scir.text"("612"), "scir.text"("657")), row("scir.text"("Authored aliases and arithmetic"), "scir.text"("2659"), "scir.text"("624"), "scir.text"("624"), "scir.text"("677"))), paragraph("scir.text"("Explicit notation is smaller for these records, but the extra alias/arithmetic\nsetup is slightly larger than explicit notation. This supports keeping those\nfeatures optional, not a universal claim that aliases or SCIR compress better.\nThe illustrative guides are counted separately; sufficiency for an agent is not\nmeasured. No current-model mapping or chat framing cost is inferred."))), "scir.kw"(area(Documentation), document("docs/profile-results.md"), level("2"), order("30"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/profile-results.md", "Information-matched representation costs", "1af2b6d6c2e386432fe815d67cbd76f8cbe49ccef3b618bb472820258221d3f6")), ownership(record), parent("scir.ref"(Doc_docs_profile_results__Profile_implementation_verification_and_measured_costs)), title("scir.text"("Information-matched representation costs"))))
record(Doc_docs_profile_results__Complete_workflow_costs, Evidence, blocks(paragraph("scir.text"("All values below are actual o200k_base tokens. The full native collection is 744.")), table(row("scir.text"(Task), "scir.text"("Selected native content"), "scir.text"("Full selection packet"), "scir.text"("Change request"), "scir.text"("Full candidate proposal")), row("scir.text"("Resume T1 with dependencies and staging scope"), "scir.text"("152"), "scir.text"("309"), "scir.text"("80"), "scir.text"("971")), row("scir.text"("Inspect assumption A1"), "scir.text"("21"), "scir.text"("117"), "scir.text"("80"), "scir.text"("971")), row("scir.text"("Resume T1 plus an independent note"), "scir.text"("189"), "scir.text"("366"), "scir.text"("80"), "scir.text"("971"))), paragraph("scir.text"("Selection packets retain collection/profile identity, source snapshot, IDs,\nreasons and whole record strings. Reporting only the selected-content column\nwould hide the metadata cost. A small change request does not imply a small\nresponse: the candidate proposal contains the entire candidate collection and\ntherefore costs more than the original native body in this example. It is not\nan end-to-end token-saving or latency claim. Hosts may separate candidate storage\nfrom a concise acknowledgment in a future explicitly specified workflow; the\ncurrent API deliberately returns the full reviewable candidate.")), paragraph("scir.text"("Target IDs are known inputs. This is declared-reference closure, not semantic\nsearch or proof that an author supplied all relevant edges. Scope, status and\nliteral uncertainty remain content; their presence does not establish truth or\nauthorization. Snapshot guards construct candidates only; persistent atomic writes\nand stronger consumer policies belong to the host."))), "scir.kw"(area(Documentation), document("docs/profile-results.md"), level("2"), order("40"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/profile-results.md", "Complete workflow costs", "1af2b6d6c2e386432fe815d67cbd76f8cbe49ccef3b618bb472820258221d3f6")), ownership(record), parent("scir.ref"(Doc_docs_profile_results__Profile_implementation_verification_and_measured_costs)), title("scir.text"("Complete workflow costs"))))
record(Doc_docs_profile_results__Adoption_decision_and_limits, Evidence, blocks(paragraph("scir.text"("Keep the native kernel unchanged. Use optional tuple/text/reference/role notation,\nfirst-order calls, explicit record identity, complete context selection and guarded\nchanges. Keep local aliases, ground abbreviations and fixed arithmetic optional.\nDo not add automatic evaluation, higher-order heads, dynamic macros, implicit\nrewriting, native graph storage or source rewriting through aliases in this release.")), paragraph("scir.text"("Independent model trials: zero. No result here establishes improved reasoning,\nrole accuracy, instruction following, retrieval quality, wall-clock agent latency\nor safety. The corpus is implementer-authored and not held out. Build and tokenizer\ntransitive dependencies are not completely locked. The checked code uses only the\nstandard library at runtime. Read [adoption guidance](profile-adoption.md) and the\n[public API](profiles-api.md) before choosing an authoritative source workflow."))), "scir.kw"(area(Documentation), document("docs/profile-results.md"), level("2"), links("scir.tuple"(link("adoption guidance", "profile-adoption.md"), link("public API", "profiles-api.md"))), order("50"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/profile-results.md", "Adoption decision and limits", "1af2b6d6c2e386432fe815d67cbd76f8cbe49ccef3b618bb472820258221d3f6")), ownership(record), parent("scir.ref"(Doc_docs_profile_results__Profile_implementation_verification_and_measured_costs)), title("scir.text"("Adoption decision and limits"))))
record(Doc_docs_research_README__Interpretation_study, Evidence, blocks(paragraph("scir.text"("Non-normative fixtures and an evaluation protocol; [SPEC.md](../../SPEC.md) defines\nstructure. These studies do not extend the language."))), "scir.kw"(area(Documentation), document("docs/research/README.md"), level("1"), links("scir.tuple"(link("SPEC.md", "../../SPEC.md"))), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/research/README.md", "Interpretation study", "0302a0a8cb3e9abc15bb63281848c505e6ea7a8c8c1f6556e34f42691f87f27b")), ownership(record), title("scir.text"("Interpretation study"))))
record(Doc_docs_research_README__Corpus, Evidence, blocks(paragraph("scir.text"("[corpus.json](corpus.json) has 17 authored English fixtures and 19 candidate\ndocuments: scope, coreference, false belief, corrections, conditions, modality,\nquotation, event references, and correlated ambiguity.")), code(bash, "scir.text"("python tools/study_corpus.py\n")), paragraph("scir.text"("The script checks structure, transport, alternatives, and selected comparisons.\nIt measures characters and depth—not tokens or translation quality. Candidates\nand backtranslations are authored fixtures, not independent model outputs.\nParaphrase equivalence is stipulated, not discovered.")), paragraph("scir.text"("Known losses include tense, contrast, quantification, event identity, and calendar\nanchors. For example, `chartOf(Report)` omits “one chart”; `answer(Carol)` omits\nwhich call. The README's scope examples are explicitly schematic."))), "scir.kw"(area(Documentation), document("docs/research/README.md"), level("2"), links("scir.tuple"(link("corpus.json", "corpus.json"))), order("10"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/research/README.md", Corpus, "0302a0a8cb3e9abc15bb63281848c505e6ea7a8c8c1f6556e34f42691f87f27b")), ownership(record), parent("scir.ref"(Doc_docs_research_README__Interpretation_study)), title("scir.text"(Corpus))))
record(Doc_docs_research_README__Structural_checks, Evidence, blocks(code(bash, "scir.text"("python tools/check_properties.py --seed 602 --cases 1000\npython tools/benchmark.py\n")), paragraph("scir.text"("Generated checks cover round trips, matching/substitution, edits, metadata erasure,\ntransport invariance, and constraint composition. They are finite checks, not proofs.\nBenchmarks report source hashes, workload, timings, and allocations as JSON. Keep\nresults with the measured revision; they are not format guarantees."))), "scir.kw"(area(Documentation), document("docs/research/README.md"), level("2"), order("20"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/research/README.md", "Structural checks", "0302a0a8cb3e9abc15bb63281848c505e6ea7a8c8c1f6556e34f42691f87f27b")), ownership(record), parent("scir.ref"(Doc_docs_research_README__Interpretation_study)), title("scir.text"("Structural checks"))))
record(Doc_docs_research_README__Agent_evaluation, Evidence, blocks(paragraph("scir.text"("Compare original English, compressed English, SCIR, and a hybrid on held-out tasks.\nUse independent translator/consumer runs, blind IDs, fixed tool budgets, and both\nequal-information and equal-token comparisons. Measure scope leaks, invented\nreferences, correction retention, answer accuracy, conformance, latency, and cost.\nAudit translation fidelity separately from downstream success; report failures.")), paragraph("scir.text"("The [skill walkthrough](../agents.md#try-a-fresh-handoff) tests onboarding. Its file\nand tool checks do not establish skill discovery or agent compliance. Those need\nactual client runs with recorded outputs, as does any claim of better handoffs."))), "scir.kw"(area(Documentation), document("docs/research/README.md"), level("2"), links("scir.tuple"(link("skill walkthrough", "../agents.md#try-a-fresh-handoff"))), order("30"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/research/README.md", "Agent evaluation", "0302a0a8cb3e9abc15bb63281848c505e6ea7a8c8c1f6556e34f42691f87f27b")), ownership(record), parent("scir.ref"(Doc_docs_research_README__Interpretation_study)), title("scir.text"("Agent evaluation"))))
record(Doc_docs_research_README__Dialect_chain_trials, Evidence, blocks(paragraph("scir.text"("The [runnable chain](../../examples/dialect-chain/README.md) freezes four source\nstatements and supplies authored representations, cumulative contracts, a small\nreviewed oracle, structural projections, and a blocked target. It makes **no model\ncalls**. Its acceptance matrix and reconstruction checks do not show that agents\nbenefit from gradual constraints.")), paragraph("scir.text"("For an independent trial, freeze a held-out source, a final contract, intermediate\ncontracts, and the source-review rubric before translation. Compare:")), table(row("scir.text"(Arm), "scir.text"("Model input")), row("scir.text"(Progressive), "scir.text"("Original source, prior draft, cumulative next contract, and diagnostics.")), row("scir.text"(Direct), "scir.text"("Original source and final contract.")), row("scir.text"("Same-contract repair"), "scir.text"("Source and final contract at every revision, with diagnostics.")), row("scir.text"("Previous-output only"), "scir.text"("Prior draft and next contract, withholding source after the first step; stress test only."))), paragraph("scir.text"("Match total token/tool/repair budgets where possible; also report actual usage.\nFor an order probe, apply vocabulary then records versus records then vocabulary,\nending at the same intersection. Do not infer path independence from contract\ncommutativity. Stop on missing information; do not reward invented specificity.")), paragraph("scir.text"("Record prompts, model/settings, source and contract hashes, raw outputs, revisions,\nviolations, and tokens/latency/cost. Do not hide failed attempts. Audit source\ncoverage, unsupported additions, ambiguity retention, and fixed downstream\nquestions independently. Structural reconstruction and backtranslation are aids,\nnot independent semantic proofs. Several different trees may be faithful.")), paragraph("scir.text"("The fixed example's questions are: when must State stay unchanged; is payload\nevaluation forbidden; what timeout is specified; which obligations share a condition?\nIn an agent trial, freeze expected answers and separate translator and evaluator.\nUnknown wordings outside the fixture oracle require review, not an automatic zero.\nThe sample runner's `--stages` option inspects externally supplied stage files;\nit does not run agents or score arbitrary English meaning."))), "scir.kw"(area(Documentation), document("docs/research/README.md"), level("2"), links("scir.tuple"(link("runnable chain", "../../examples/dialect-chain/README.md"))), order("40"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/research/README.md", "Dialect-chain trials", "0302a0a8cb3e9abc15bb63281848c505e6ea7a8c8c1f6556e34f42691f87f27b")), ownership(record), parent("scir.ref"(Doc_docs_research_README__Interpretation_study)), title("scir.text"("Dialect-chain trials"))))
record(Doc_experiments_refinement_20260914_README__Historical_cumulative_profile_experiment, Evidence, blocks(paragraph("scir.text"("The original experiment is preserved in Git at\n[`b91b32718dc9bc53b56f6b383c89e3095252623f`](https://github.com/tigerwits/scir/tree/b91b32718dc9bc53b56f6b383c89e3095252623f).\nIt contains the original `src/scir/refinement.py`, example and two test files.\nThe archive merge retained this commit as a parent; no history was rewritten.")), paragraph("scir.text"("Use a separate checkout of that exact revision to reproduce it:")), code(sh, "scir.text"("git worktree add --detach ../scir-refinement b91b32718dc9bc53b56f6b383c89e3095252623f\ncd ../scir-refinement\nPYTHONPATH=src python -B -m unittest discover -s tests -p 'test_refinement*.py' -v\n")), paragraph("scir.text"("These are historical tests, not current passing benchmarks or a supported API.\nCurrent named dialects were adopted separately. The old implementation is not\ncopied into the active source tree or installed package."))), "scir.kw"(area(Documentation), document("experiments/refinement-20260914/README.md"), level("1"), links("scir.tuple"(link("`b91b32718dc9bc53b56f6b383c89e3095252623f`", "https://github.com/tigerwits/scir/tree/b91b32718dc9bc53b56f6b383c89e3095252623f"))), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "experiments/refinement-20260914/README.md", "Historical cumulative-profile experiment", "244f45060f4d5fc311b8bcd55cc02f943fed8b7201610789f1344708d3f3012a")), ownership(record), title("scir.text"("Historical cumulative-profile experiment"))))
record(MigrationDevelopmentPilot, Evidence, blocks(paragraph("scir.text"("Status: planned; zero independent model trials have been run. Freeze the exact baseline and candidate revisions, model settings, prompts, budgets, source packets and evaluator rubric before execution. The six development tasks below are not an independent held-out benchmark.")), table(row("scir.text"(Task), "scir.text"("Prompt goal"), "scir.text"("Reviewed criterion")), row("scir.text"("Requirement edit"), "scir.text"("Change a named-role requirement without changing native argument arity."), "scir.text"("Keep native format 1.0 and independent expected values; find the owning section and tests.")), row("scir.text"("Governing exception"), "scir.text"("Explain what a passing repository check does not establish."), "scir.text"("Distinguish shape, declarations, execution, semantic fidelity and external approval.")), row("scir.text"("Proof limitation"), "scir.text"("State the scope of ProfileLaws.lean for the Python implementation."), "scir.text"("A model theorem is not a verified implementation; cite the qualification.")), row("scir.text"("Dialect extension"), "scir.text"("Propose a dialect constraint with a prerequisite."), "scir.text"("Keep names/hashes distinct from permission, execution and truth.")), row("scir.text"("Release workflow"), "scir.text"("List the checks and permissions before a release."), "scir.text"("Build both distributions outside checkout; no unrequested tag or publication.")), row("scir.text"("Portable skill"), "scir.text"("Use the exported skill from an unrelated project directory."), "scir.text"("Correct package identity; relative references and license; no checkout dependency."))), items(unordered, "scir.text"("Four arms: cleaned Markdown with raw access; cleaned Markdown with scoped retrieval; SCIR with raw access; SCIR with comparable scoped retrieval."), "scir.text"("One run per task/arm gives 24 development runs, not a general superiority claim. Match total information and tool/repair budgets; report actual token, time and cost consumption including bootstrap, selection envelopes and later artifact fetches."), "scir.text"("Score unsupported claims, missed qualifications and correctness before size or latency. Keep translator and evaluator separate. Retain failed attempts, raw outputs, model/version/settings and source/contract hashes."), "scir.text"("Use fresh confirmatory tasks not shown during migration when evaluating broader adoption. The private grill remains independent and pinned, and is not a dependency of this repository."))), "scir.kw"(area(Documentation), document("docs/research/migration-trials.md"), evidence("scir.tuple"("scir.ref"(NoAgentTrials))), level("1"), order("0"), origin(authored("scir.text"("Approved migration research plan; protocol only, not observations."))), ownership(record), status(planned), title("scir.text"("SCIR-first migration development pilot"))))
