record(Doc_docs_profiles_api__Optional_profiles_Python_and_CLI_API, Guide, blocks(paragraph("scir.text"("Package 1.1 adds these interfaces; native format 1.0 and all previously documented\nAPIs remain unchanged. The [profile contract](structured-profiles.md) owns semantic\nrules. A generic native document is not automatically a structured or working\nprofile. Use the project interpreter and select the intended interface explicitly."))), "scir.kw"(area(Documentation), document("docs/profiles-api.md"), level("1"), links("scir.tuple"(link("profile contract", "structured-profiles.md"))), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/profiles-api.md", "Optional profiles: Python and CLI API", "6e3b9d6bd59e8bf22d1defedff15438690cf789a79d523697e3ed7c464690e6d")), ownership(record), title("scir.text"("Optional profiles: Python and CLI API"))))
record(Doc_docs_profiles_api__Structured_values, Guide, blocks(paragraph("scir.text"("`scir.profile` exports `VERSION = \"structured/1\"`, `TUPLE`, `TEXT`, `REF`, `KW`,\n`RESERVED`, `ProfileError`, `LimitError`, immutable `Limits` and `Size`, and:")), table(row("scir.text"(Function), "scir.text"(Result)), row("scir.text"("`text(value: str)` / `read_text(term)`"), "scir.text"("Tagged exact text / decoded string, including empty text")), row("scir.text"("`reference(identifier: str)` / `read_reference(term)`"), "scir.text"("Tagged local reference / literal ID")), row("scir.text"("`tuple_value(items=(), *, fields=(), limits=Limits())`"), "scir.text"("Tagged tuple; no implicit flattening")), row("scir.text"("`application(head, positional=(), *, fields=(), limits=Limits())`"), "scir.text"("Ordinary symbol-headed term with optional named roles")), row("scir.text"("`read_tuple(term)`"), "scir.text"("Tuple's positional components only")), row("scir.text"("`read_arguments(term)`"), "scir.text"("Ordinary application's positional components only")), row("scir.text"("`read_fields(term)`"), "scir.text"("Immutable `(name, value)` pairs in canonical order")), row("scir.text"("`validate(document, *, limits=Limits())`"), "scir.text"("`Size` or explicit error; never repairs content")), row("scir.text"("`measure(document, *, limits=Limits())`"), "scir.text"("Exact native canonical bytes and occurrence counts"))), paragraph("scir.text"("Inputs `items`, `positional`, and `fields` are tuples; every field is a `(str, Term)`\npair. Duplicate keys fail, including equal duplicates. Readers validate their\ninputs. Text and reference constructors validate payload scalar strings; profile\nor workflow boundaries enforce aggregate resource bounds. Do not pass unbounded\nPython-built objects directly to native recursive printing before validation.")), paragraph("scir.text"("`Limits(nodes=100000, depth=128, bytes=16000000)` requires strict integers, not\nBooleans. Nodes/bytes are positive, depth is 0..128. `Size(nodes, depth, bytes)`\ncounts every occurrence and one LF per document root; empty documents measure zero.\nTags consume real native nodes, depth, and bytes. Physical sharing saves no budget.\nThese are bounded interfaces, not a sandbox against reflected/mutated Python values.")), code(python, "scir.text"("from scir import Term, parse\nfrom scir.profile import application, text, tuple_value, reference\n\nsend = application(\"send\", (Term(\"doc\"),),\n                   fields=((\"to\", Term(\"bob\")), (\"from\", Term(\"alice\"))))\nassert send == parse('send(doc, \"scir.kw\"(from(alice), to(bob)))')\nassert tuple_value((Term(\"a\"),)) != Term(\"a\")\nassert text(\"A1\") != reference(\"A1\")\n"))), "scir.kw"(area(Documentation), document("docs/profiles-api.md"), level("2"), order("10"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/profiles-api.md", "Structured values", "6e3b9d6bd59e8bf22d1defedff15438690cf789a79d523697e3ed7c464690e6d")), ownership(record), parent("scir.ref"(Doc_docs_profiles_api__Optional_profiles_Python_and_CLI_API)), title("scir.text"("Structured values"))))
record(Doc_docs_profiles_api__Notation, Guide, blocks(paragraph("scir.text"("`scir.notation` exports `VERSION = \"notation/1\"` and:")), code(text, "scir.text"("lower(source, *, operators=None, limits=Limits()) -> Document\npretty(document, *, operators=None, limits=Limits()) -> str\nenvironment_digest(operators=None) -> str\n")), paragraph("scir.text"("`operators` is exactly `None` or `\"arithmetic/1\"`. The environment digest identifies\nthe resolved fixed table plus notation/profile versions; it is separate from the\nnative content digest. No document can load code, an operator pack, or a URL.")), paragraph("scir.text"("Notation `Limits(source_bytes=64000, tokens=16000, nodes=8000, depth=64,\nexpanded_bytes=256000, declarations=128)` uses positive integers, with depth at\nmost 64. `.content()` returns the corresponding structured-content limits.\nLimits cover unused declarations, aggregate expansion and each shared occurrence.\nThe native parser's independent bounds still apply to the final reparse.")), paragraph("scir.text"("`lower` checks native format/parse roundtrip. `pretty` emits explicit, checked\nprefix spelling, not necessarily infix notation. It never invents abbreviations,\nrecovers comments, or edits authored source; failure emits no truncated spelling.\nAliases are erased and each separately processed document starts with fresh bindings.")), code(python, "scir.text"("from scir.notation import lower\nfrom scir import parse_document\n\nassert lower(\"send(doc, to: bob, from: alice)\") == parse_document(\n    'send(doc, \"scir.kw\"(from(alice), to(bob)))')\nassert lower(\"a + b\", operators=\"arithmetic/1\") == lower(\"plus(a,b)\")\nassert lower(\"f(a,b)\") != lower(\"f((a,b))\")\n"))), "scir.kw"(area(Documentation), document("docs/profiles-api.md"), level("2"), order("20"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/profiles-api.md", Notation, "6e3b9d6bd59e8bf22d1defedff15438690cf789a79d523697e3ed7c464690e6d")), ownership(record), parent("scir.ref"(Doc_docs_profiles_api__Optional_profiles_Python_and_CLI_API)), title("scir.text"(Notation))))
record(Doc_docs_profiles_api__Working_records, Guide, blocks(code(text, "scir.text"("build_index(document, *, collection, limits=profile.Limits(), max_records=10000)\n    -> Index\nselect(index, identifiers, *, max_records=10000, limits=profile.Limits())\n    -> Selection\naffected(index, changed, *, max_records=10000, max_bytes=16000000)\n    -> tuple[str, ...]\n")), paragraph("scir.text"("`identifiers`/`changed` are immutable ID tuples. Duplicates are collapsed in first\nrequest order, but count toward input bounds. Empty tuples are valid in Python.\nThe CLI requires at least one explicit seed. Collection identity is a nonempty\nhost-supplied Unicode-scalar string, not inferred from a filename.")), paragraph("scir.text"("Index construction validates the entire collection. Use `build_index`; `Index`\nand `Record` are returned snapshots, not unchecked alternative construction APIs.\nDo not mutate native Terms by reflection or manufacture inconsistent Index maps.")), paragraph("scir.text"("Result fields:")), paragraph("scir.text"("- `Record(id, kind, payload, fields, term)` preserves the original term.\n- `Index(collection, document, snapshot, records, references, dependents)` has\n  detached read-only mappings; reference/dependent lists are immutable tuples.\n- `Selection(collection, source_snapshot, requested_ids, selected_ids, document,\n  reasons, profile=\"working/1\", complete=True)` contains whole original records.\n  A reason is `(id, \"requested\"|\"reference\", via_id_or_none)`. The first discovered\n  path is reported, not every possible path. `.as_dict()` returns a caller-owned\n  JSON-compatible mapping with canonical native record strings.")), paragraph("scir.text"("Selection uses every explicit local reference. Reverse review impact uses only\n`dependsOn`. Reference and dependency cycles terminate. No text matching, semantic\nsearch, truth inference, supersession deletion or authorization is performed.\nRequired context is complete only with respect to authored references.")), paragraph("scir.text"("Selection's `limits.bytes` includes its complete compact-JSON packet plus final LF,\nnot just its content. `affected` bounds its returned compact JSON array plus LF;\na host adding metadata must additionally bound its full response. Limit failures\nraise `LimitError`, never return a partially complete result.")), paragraph("scir.text"("Indexes and packets are snapshot-local. Their content fingerprints ignore comments\nand formatting and do not detect an A-to-B-to-A history. They are not signatures or\nproof that the collection name belongs to a particular remote service."))), "scir.kw"(area(Documentation), document("docs/profiles-api.md"), level("2"), order("30"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/profiles-api.md", "Working records", "6e3b9d6bd59e8bf22d1defedff15438690cf789a79d523697e3ed7c464690e6d")), ownership(record), parent("scir.ref"(Doc_docs_profiles_api__Optional_profiles_Python_and_CLI_API)), title("scir.text"("Working records"))))
record(Doc_docs_profiles_api__Change_proposals, Guide, blocks(paragraph("scir.text"("`scir.changes.VERSION = \"scir-change/1\"` identifies the exact JSON request schema.")), code(text, "scir.text"("read_request(source, *, max_bytes=1000000, max_operations=1024,\n             limits=profile.Limits()) -> Request\npropose(index, source, *, limits=profile.Limits(), max_records=10000,\n        max_operations=1024, max_request_bytes=1000000,\n        max_result_bytes=16000000) -> Proposal\n")), paragraph("scir.text"("`source` is JSON text, not a path or executable expression. `Request`/`Operation`\nare immutable results; `.as_dict()` returns caller-owned transport data. Passing\nterm strings in notation syntax, or noncanonical native strings, is an error.\nUnknown envelope/operation fields, duplicate JSON keys and non-JSON numeric constants\nfail. Term count/size limits also apply across all inserted terms in the request.")), paragraph("scir.text"("An empty operation list is a guarded no-op. No two operations may write the same\npayload/field. Creation/deletion conflicts with every other operation on that ID.\nDistinct fields of one record can change together. `setField` cannot change the\nfixed ID, kind or payload slots. Deleting a referenced record is allowed only when\nthe batch also repairs/removes references, leaving a valid final collection.")), paragraph("scir.text"("`Proposal(collection, before_snapshot, candidate_snapshot, document, request)` is\nreturned only after whole-candidate `working/1` validation. `.as_dict()` includes\nversion `scir-proposal/1`, profile identity, canonical candidate records and a\ncomplete validation marker. That marker certifies only this profile check, not a\nstronger project policy. Run additional consumer constraints before persistence.")), paragraph("scir.text"("The full source snapshot and collection must match. The original Index/document\nremain unchanged on both success and failure. No file is written. To persist a\ncandidate, the host must atomically enforce the precondition at commit. Checking\nfirst and writing later is not a transaction. Selective read sets, persistent\nhistory, source edits through aliases and automatic conflict resolution are absent."))), "scir.kw"(area(Documentation), document("docs/profiles-api.md"), level("2"), order("40"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/profiles-api.md", "Change proposals", "6e3b9d6bd59e8bf22d1defedff15438690cf789a79d523697e3ed7c464690e6d")), ownership(record), parent("scir.ref"(Doc_docs_profiles_api__Optional_profiles_Python_and_CLI_API)), title("scir.text"("Change proposals"))))
record(Doc_docs_profiles_api__CLI, Guide, blocks(code(sh, "scir.text"("python -m scir lower notes.scix --operators arithmetic/1\npython -m scir knowledge check notes.scir --collection project\npython -m scir knowledge select notes.scir --collection project --id T1\npython -m scir knowledge affected notes.scir --collection project --changed A1\npython -m scir knowledge propose notes.scir --collection project --change change.json\n")), paragraph("scir.text"("Only `lower` consumes notation. Knowledge commands consume native SCIR, even when\na path ends in `.scix`. An absent path or `-` means stdin; document and change\nrequest cannot both consume stdin. `--max-records` (default 10000) applies to the\nsource collection and result; `--max-output-bytes` (default 16000000) bounds the\ncomplete knowledge response. Values must be positive integers. Native parsing\nretains its independent source/node/depth limits. Change JSON is bounded to 1 MB.")), paragraph("scir.text"("New commands return 0 for success, 1 for completed rejection/conflict, and 2 for\nincomplete checks (resource exhaustion, unavailable files, recursion failure).\nFailures write JSON diagnostics only to stderr and no partial success to stdout.\nArgparse usage failures also return 2. The adapter maps native 1.0 parser budget\nfailures to incomplete results, with regression tests for that boundary.\nExisting native commands retain their original exit codes and outputs.")), paragraph("scir.text"("All command output uses UTF-8 and LF, independently of terminal encoding/platform.\nCommands do not overwrite files, choose a lower-trust profile from input, or install\na package. Never redirect output onto the input file. Review candidate content and\npreserve ownership of authored notation versus maintained canonical content."))), "scir.kw"(area(Documentation), document("docs/profiles-api.md"), level("2"), order("50"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/profiles-api.md", CLI, "6e3b9d6bd59e8bf22d1defedff15438690cf789a79d523697e3ed7c464690e6d")), ownership(record), parent("scir.ref"(Doc_docs_profiles_api__Optional_profiles_Python_and_CLI_API)), title("scir.text"(CLI))))
record(Doc_docs_profiles_api__Diagnostics_and_optional_delivery, Guide, blocks(paragraph("scir.text"("The additive `scir.diagnostics` and `scir.delivery` modules provide bounded cost\nreports and optional response views. See [the workflow API](workflow-tools.md)\nfor exact arguments, wire schemas, reader checks and byte limits. The original\n`Selection`, `Proposal`, `select()` and `propose()` response contracts stay intact.\nNew results are output values, not unchecked constructors for accepted state.")), paragraph("scir.text"("The runtime and repository CLIs retain full responses by default. Explicit compact\nviews retain whole selected records; proposal views are labelled deltas. Full\naudit/candidate data remains in a hash-bound artifact. Later retrieval costs count,\nand a small packet does not authorize a source write.")), paragraph("scir.text"("The [consumer lifecycle example](../examples/consumer-lifecycle/README.md) shows\ntrusted policy, evidence requirements and explicit replacement resolution. Those\nrules belong to that example, not the generic library. A status label, represented\nreceipt or successful generic parse cannot authenticate execution or approval."))), "scir.kw"(area(Documentation), document("docs/profiles-api.md"), level("2"), links("scir.tuple"(link("the workflow API", "workflow-tools.md"), link("consumer lifecycle example", "../examples/consumer-lifecycle/README.md"))), order("60"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/profiles-api.md", "Diagnostics and optional delivery", "6e3b9d6bd59e8bf22d1defedff15438690cf789a79d523697e3ed7c464690e6d")), ownership(record), parent("scir.ref"(Doc_docs_profiles_api__Optional_profiles_Python_and_CLI_API)), title("scir.text"("Diagnostics and optional delivery"))))
record(Doc_docs_profiles_api__Named_acceptance_contracts, Guide, blocks(paragraph("scir.text"("`scir.dialects` composes named trusted rules and returns content-, collection-,\ncontract- and context-bound results. See [the contract](dialect-contracts.md) and\n[profile-aware helpers](dialect-rules.md). Existing profile exceptions, knowledge\ncommands and default response shapes are unchanged. Dialect code is selected by\nthe host, never loaded from a document or a command-line module string."))), "scir.kw"(area(Documentation), document("docs/profiles-api.md"), level("2"), links("scir.tuple"(link("the contract", "dialect-contracts.md"), link("profile-aware helpers", "dialect-rules.md"))), order("70"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/profiles-api.md", "Named acceptance contracts", "6e3b9d6bd59e8bf22d1defedff15438690cf789a79d523697e3ed7c464690e6d")), ownership(record), parent("scir.ref"(Doc_docs_profiles_api__Optional_profiles_Python_and_CLI_API)), title("scir.text"("Named acceptance contracts"))))
record(Doc_docs_api__Python_API, Guide, blocks(paragraph("scir.text"("Install the package first. Names, signatures, return fields, and CLI behavior\nhere define the 1.x public API. Other helpers are implementation details.\n[SPEC.md](../SPEC.md) defines structure and limits; [examples](examples.md) show workflows."))), "scir.kw"(area(Documentation), document("docs/api.md"), level("1"), links("scir.tuple"(link("SPEC.md", "../SPEC.md"), link(examples, "examples.md"))), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/api.md", "Python API", "33b3296b7e9a76398345b143890f4cfa227cd32f35cbf4205fd777abce7dd7af")), ownership(record), title("scir.text"("Python API"))))
record(Doc_docs_api__Primary_interface, Guide, blocks(table(row("scir.text"(Name), "scir.text"(Contract)), row("scir.text"("`Term(symbol, args=())`, `Document`"), "scir.text"("Immutable ground tree; document is a tuple of Terms.")), row("scir.text"("`parse(source)`"), "scir.text"("Exactly one ground Term.")), row("scir.text"("`parse_document(source)`"), "scir.text"("An ordered tuple, possibly empty.")), row("scir.text"("`format_document(document)`"), "scir.text"("Canonical source with one LF after each root.")), row("scir.text"("`parse_pattern(source)`"), "scir.text"("Exactly one separate Pattern.")), row("scir.text"("`match(pattern, term)`"), "scir.text"("Capture dictionary on success; `None` on failure.")), row("scir.text"("`query(document, pattern, scope=\"roots\")`"), "scir.text"("See [Queries](#queries).")), row("scir.text"("`validate(document)`"), "scir.text"("Check the Document shape; raise `ValueError` on invalid input.")), row("scir.text"("`digest(document)`"), "scir.text"("Versioned canonical-content fingerprint.")), row("scir.text"("`diff(before, after)`"), "scir.text"("Positional `Difference(path, before, after)` frontier.")), row("scir.text"("`replace_at(document, path, term)`"), "scir.text"("New document with exactly one occurrence replaced.")), row("scir.text"("`ParseError`"), "scir.text"("Parsing failure with `index`, `line`, and `column`.")), row("scir.text"("`FORMAT_VERSION`, `__version__`"), "scir.text"("Structural format version and package implementation version."))), paragraph("scir.text"("Parsers accept `max_nodes` and `max_depth` for the whole document. Parsing detects\nsyntax errors, not translation mistakes."))), "scir.kw"(area(Documentation), document("docs/api.md"), level("2"), links("scir.tuple"(link(Queries, "#queries"))), order("10"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/api.md", "Primary interface", "33b3296b7e9a76398345b143890f4cfa227cd32f35cbf4205fd777abce7dd7af")), ownership(record), parent("scir.ref"(Doc_docs_api__Python_API)), title("scir.text"("Primary interface"))))
record(Doc_docs_api__Pattern_construction_and_substitution, Guide, blocks(code(python, "scir.text"("from scir import parse, parse_pattern, match\nfrom scir.patterns import Node, Var, instantiate\n\npattern = Node(\"pair\", (Var(\"x\"), Var(\"x\")))\nassert match(pattern, parse(\"pair(A, B)\")) is None\nbindings = match(pattern, parse(\"pair(A, A)\"))\nassert bindings is not None\nassert instantiate(pattern, bindings) == parse(\"pair(A, A)\")\nassert match(parse_pattern(\"pair(?_, ?_)\"), parse(\"pair(A, B)\")) == {}\n")), paragraph("scir.text"("`?_` deliberately discards content and cannot be instantiated. Substitution is\none finite structural operation, not recursive macro evaluation. Ground Term\nconstructors reject pattern children."))), "scir.kw"(area(Documentation), document("docs/api.md"), level("2"), order("20"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/api.md", "Pattern construction and substitution", "33b3296b7e9a76398345b143890f4cfa227cd32f35cbf4205fd777abce7dd7af")), ownership(record), parent("scir.ref"(Doc_docs_api__Python_API)), title("scir.text"("Pattern construction and substitution"))))
record(Doc_docs_api__Queries, Guide, blocks(projection("query-api")), "scir.kw"(area(Documentation), document("docs/api.md"), level("2"), order("30"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/api.md", Queries, "33b3296b7e9a76398345b143890f4cfa227cd32f35cbf4205fd777abce7dd7af")), ownership(record), parent("scir.ref"(Doc_docs_api__Python_API)), title("scir.text"(Queries))))
record(Doc_docs_api__Occurrences_and_edits, Guide, blocks(code(python, "scir.text"("from scir import parse, parse_document, replace_at, diff\nfrom scir.tree import at, walk\n\ncontent = parse_document(\"f(A, A); f(A, A)\")\nchanged = replace_at(content, (0, 1), parse(\"B\"))\nassert at(changed, (1,)) == content[1]\nassert [item.path for item in diff(content, changed)] == [(0, 1)]\nassert len(list(walk(content))) == 6\n")), paragraph("scir.text"("`Difference`, `walk`, and `at` live in `scir.tree`; `Path` lives in\n`scir.core`. Editing a document does not relocate its annotation paths."))), "scir.kw"(area(Documentation), document("docs/api.md"), level("2"), order("40"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/api.md", "Occurrences and edits", "33b3296b7e9a76398345b143890f4cfa227cd32f35cbf4205fd777abce7dd7af")), ownership(record), parent("scir.ref"(Doc_docs_api__Python_API)), title("scir.text"("Occurrences and edits"))))
record(Doc_docs_api__Metadata_and_interpretation_choices, Guide, blocks(code(python, "scir.text"("from scir import parse_document\nfrom scir.annotations import Alternatives, Bundle, annotate, erase\n\ncontent = parse_document(\"think(Bob, wrong(Chart))\")\nnote = annotate(content, (0,), \"source\", {\"sentence\": 1})\nbundle = Bundle(content, (note,))\nassert erase(bundle) == content\nassert note.value_json == '{\"sentence\":1}'\n\nchoices = Alternatives((\n    parse_document(\"after(speak(Alice, Carol), leave(Alice))\"),\n    parse_document(\"after(speak(Alice, Carol), leave(Carol))\"),\n))\nassert choices.choose(1) == choices.options[1]\n")), paragraph("scir.text"("`annotate` returns a detached record; Bundle checks its snapshot and path.\nUse `scir.annotations.Annotation` to load stored records. SCIR neither generates\ninterpretations nor chooses the correct one. `erase(choices)` is an error."))), "scir.kw"(area(Documentation), document("docs/api.md"), level("2"), order("50"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/api.md", "Metadata and interpretation choices", "33b3296b7e9a76398345b143890f4cfa227cd32f35cbf4205fd777abce7dd7af")), ownership(record), parent("scir.ref"(Doc_docs_api__Python_API)), title("scir.text"("Metadata and interpretation choices"))))
record(Doc_docs_api__Transport, Guide, blocks(code(python, "scir.text"("import json\nfrom scir import parse_document\nfrom scir.relations import encode, decode\n\ncontent = parse_document(\"f(A, B); f(A, B)\")\nwire = encode(content)\nassert decode(json.loads(json.dumps(wire))) == content\nassert len(wire[\"nodes\"]) == 6\n")), paragraph("scir.text"("The codec describes an occurrence forest, not a deduplicated graph. Decode\nvalidates its tables. Applications reading JSON themselves must reject duplicate\nobject keys before passing the resulting dictionary to `decode`; the SCIR CLI\nalready does so."))), "scir.kw"(area(Documentation), document("docs/api.md"), level("2"), order("60"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/api.md", Transport, "33b3296b7e9a76398345b143890f4cfa227cd32f35cbf4205fd777abce7dd7af")), ownership(record), parent("scir.ref"(Doc_docs_api__Python_API)), title("scir.text"(Transport))))
record(Doc_docs_api__Optional_constraints, Guide, blocks(paragraph("scir.text"("`scir.constraints` exports `Violation`, `Constraint`, `check`, `forms`, and\n`vocabulary`. They check ground documents without changing structural `validate`.\n[Dialects](dialects.md) defines their 1.x signatures, diagnostics, and trust boundary."))), "scir.kw"(area(Documentation), document("docs/api.md"), level("2"), links("scir.tuple"(link(Dialects, "dialects.md"))), order("70"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/api.md", "Optional constraints", "33b3296b7e9a76398345b143890f4cfa227cd32f35cbf4205fd777abce7dd7af")), ownership(record), parent("scir.ref"(Doc_docs_api__Python_API)), title("scir.text"("Optional constraints"))))
record(Doc_docs_api__CLI_contract, Guide, blocks(paragraph("scir.text"("All commands accept an optional file path; absent paths and `-` mean stdin.")), table(row("scir.text"(Command), "scir.text"(Output)), row("scir.text"("`check`"), "scir.text"("JSON with `valid` and root count.")), row("scir.text"("`fmt`"), "scir.text"("Canonical source, never an in-place write.")), row("scir.text"("`fmt --check`"), "scir.text"("No stdout; return 0 if canonical, 1 if different, 2 if invalid.")), row("scir.text"("`query --pattern PATTERN [--scope roots\\|all] [--contains SYMBOL]`"), "scir.text"("JSON results with paths, printed terms, and printed capture values.")), row("scir.text"("`digest`"), "scir.text"("Lowercase hexadecimal fingerprint.")), row("scir.text"("`encode` / `decode`"), "scir.text"("Relational JSON / reconstructed canonical source.")), row("scir.text"("`--version`"), "scir.text"("Package and format versions."))), paragraph("scir.text"("Errors go to stderr and return 2. `--contains` compares exact symbol labels\ninside matched terms. Format checks retain file newline bytes when reading, so\nCRLF is noncanonical; stdin checks the text supplied by the host stream.\nCommand data and processing errors are written as UTF-8 with LF line endings,\nindependently of the terminal encoding or platform newline translation. Embedded\ncalls to `main` also support text-only streams such as `io.StringIO`."))), "scir.kw"(area(Documentation), document("docs/api.md"), level("2"), order("80"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/api.md", "CLI contract", "33b3296b7e9a76398345b143890f4cfa227cd32f35cbf4205fd777abce7dd7af")), ownership(record), parent("scir.ref"(Doc_docs_api__Python_API)), title("scir.text"("CLI contract"))))
record(Doc_docs_api__Version_information, Guide, blocks(paragraph("scir.text"("`scir.__version__` identifies the Python implementation. `scir.FORMAT_VERSION`\nidentifies canonical content and transport semantics. `scir.relations.VERSION`\nis the envelope identifier derived from that format version. Never use a package\npatch version or Python `hash()` as a content-format identifier."))), "scir.kw"(area(Documentation), document("docs/api.md"), level("2"), order("90"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/api.md", "Version information", "33b3296b7e9a76398345b143890f4cfa227cd32f35cbf4205fd777abce7dd7af")), ownership(record), parent("scir.ref"(Doc_docs_api__Python_API)), title("scir.text"("Version information"))))
record(Doc_docs_agents__Use_SCIR_with_an_agent, Guide, blocks(paragraph("scir.text"("Install two things: the Python package for deterministic operations, and the skill\nfor instructions. Cloning alone does not register a skill in an agent.\n[AGENTS.md](../AGENTS.md) is for maintaining SCIR, not using it elsewhere."))), "scir.kw"(area(Documentation), document("docs/agents.md"), level("1"), links("scir.tuple"(link("AGENTS.md", "../AGENTS.md"))), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/agents.md", "Use SCIR with an agent", eda61baf999bc1b537e90c172ee97387ad44027a7319dc10d5a3414769ebb349)), ownership(record), title("scir.text"("Use SCIR with an agent"))))
record(Doc_docs_agents__Choose_the_task, Guide, blocks(paragraph("scir.text"("Use [scir](../skills/scir/SKILL.md) for drafting, queries, edits, and checks.\nUse [scir-migrate](../skills/scir-migrate/SKILL.md) when deliberately moving\nworking knowledge out of Markdown while keeping a clear authored explanation.\nBoth folders are portable; neither requires installing the other skill.")), paragraph("scir.text"("The migration skill preserves source scope, attribution, assumptions, and open\nquestions. It proposes an ownership split before shortening prose. It does not\nrequire Markdown generation or treat structural validation as source review."))), "scir.kw"(area(Documentation), document("docs/agents.md"), level("2"), links("scir.tuple"(link(scir, "../skills/scir/SKILL.md"), link("scir-migrate", "../skills/scir-migrate/SKILL.md"))), order("10"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/agents.md", "Choose the task", eda61baf999bc1b537e90c172ee97387ad44027a7319dc10d5a3414769ebb349)), ownership(record), parent("scir.ref"(Doc_docs_agents__Use_SCIR_with_an_agent)), title("scir.text"("Choose the task"))))
record(Doc_docs_agents__Install_in_your_project, Guide, blocks(paragraph("scir.text"("For a standalone first run, use the [README setup](../README.md#start).\nFor an existing project, use its own environment and the steps below.")), paragraph("scir.text"("Clone SCIR to a location of your choice. These commands use a POSIX shell;\nWindows users can copy the same folder manually and use their environment's\nPython executable.")), code(bash, "scir.text"("git clone https://github.com/tigerwits/scir.git\ncd scir\nSCIR_SOURCE=\"$PWD\"\n")), paragraph("scir.text"("Switch to your consuming project's root, replacing the example path below:")), code(bash, "scir.text"("cd /path/to/your/project\n")), paragraph("scir.text"("Activate that project's existing virtual environment. If it needs a new one\non macOS/Linux:")), code(bash, "scir.text"("python3 -m venv .venv\n. .venv/bin/activate\n")), paragraph("scir.text"("Install from the SCIR checkout, then export a portable skill bundle:")), code(bash, "scir.text"("python -m pip install \"$SCIR_SOURCE\"\npython -m scir --version\nSKILL=scir  # Use scir-migrate for a Markdown knowledge migration.\nmkdir -p .agents/skills\npython \"$SCIR_SOURCE/spec/check.py\" export --skill \"$SKILL\" --out \"$PWD/.agents/skills/$SKILL\"\n")), paragraph("scir.text"("The export refuses to overwrite an existing destination. Review and replace old\ncopies deliberately when updating. It does not edit project instructions.")), table(row("scir.text"(Agent), "scir.text"("Project destination"), "scir.text"("Explicit invocation")), row("scir.text"(Codex), "scir.text"("`.agents/skills/scir/`"), "scir.text"("`$scir`")), row("scir.text"("Claude Code"), "scir.text"("`.claude/skills/scir/`"), "scir.text"("`/scir`"))), paragraph("scir.text"("For the migration skill, use `scir-migrate` in the destination and invocation.\nFor Claude Code, substitute `.claude/skills` in the export destination. Start the agent\nin that project. Restart if the new skill does not appear. Other clients may read\n`SKILL.md` explicitly if they do not support skill discovery.")), paragraph("scir.text"("For a file-aware agent without a skill loader, ask:")), quote("scir.text"("> Read the installed scir/SKILL.md and follow it for this task. Use this project's\n> Python environment. Structure my notes in SCIR and run the supplied checks.")), paragraph("scir.text"("The folder carries its references and license. It does not carry the Python\npackage. Installing it alone cannot make the tools available. The package is not\npublished to PyPI; do not substitute the unrelated distribution named `scir`."))), "scir.kw"(area(Documentation), document("docs/agents.md"), level("2"), links("scir.tuple"(link("README setup", "../README.md#start"))), order("20"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/agents.md", "Install in your project", eda61baf999bc1b537e90c172ee97387ad44027a7319dc10d5a3414769ebb349)), ownership(record), parent("scir.ref"(Doc_docs_agents__Use_SCIR_with_an_agent)), title("scir.text"("Install in your project"))))
record(Doc_docs_agents__Try_a_fresh_handoff, Guide, blocks(paragraph("scir.text"("Copy [the starter project](../examples/skill-project/) into a separate directory.\nInstall the package and skill there using the steps above. The starter contains\nsource notes, a draft, and a small consumer-owned checker.")), code(bash, "scir.text"("python check_handoff.py draft.scir\n")), paragraph("scir.text"("Expected: exit 1 and `unknown-reference` at `(2, 1)` for `H7`. The draft is valid\nSCIR, but it does not satisfy the supplied contract. Ask the agent:")), quote("scir.text"("> Use SCIR to review notes.txt and draft.scir. Run check_handoff.py without\n> changing it. Report unresolved references and preserve both readings of the\n> ambiguous pronoun. Do not invent a declaration or repair a reference by guessing.")), paragraph("scir.text"("A successful response reports the missing `H7`, preserves the Alice/Carol readings\nseparately, and does not claim dialect conformance. To test justified repair,\nexplicitly authorize changing `H7` to `H1`, then rerun the checker: exit 0.")), paragraph("scir.text"("The checker validates records, not prose interpretation. Pronoun handling is a\nmanual agent-evaluation criterion, not something these deterministic tests prove."))), "scir.kw"(area(Documentation), document("docs/agents.md"), level("2"), links("scir.tuple"(link("the starter project", "../examples/skill-project/"))), order("30"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/agents.md", "Try a fresh handoff", eda61baf999bc1b537e90c172ee97387ad44027a7319dc10d5a3414769ebb349)), ownership(record), parent("scir.ref"(Doc_docs_agents__Use_SCIR_with_an_agent)), title("scir.text"("Try a fresh handoff"))))
record(Doc_docs_agents__Try_a_knowledge_migration, Guide, blocks(paragraph("scir.text"("Use the [worked cases](../examples/knowledge/README.md) or selected project notes.\nA request for the migration skill can be:")), quote("scir.text"("> Preserve these source notes. Move the decisions, assumptions, explicit reasons,\n> evidence, and open questions into SCIR with source references. Write an overview\n> for a new teammate, not a transcription of the records. Do not invent a renderer.\n> Report important omissions, unresolved interpretations, and actual checks.")), paragraph("scir.text"("Review meaning before accepting the migration. A record for every source paragraph\ncan still be a bad translation. Original notes remain historical evidence after\nan explicit ownership transfer, not a second automatically synchronized spec."))), "scir.kw"(area(Documentation), document("docs/agents.md"), level("2"), links("scir.tuple"(link("worked cases", "../examples/knowledge/README.md"))), order("40"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/agents.md", "Try a knowledge migration", eda61baf999bc1b537e90c172ee97387ad44027a7319dc10d5a3414769ebb349)), ownership(record), parent("scir.ref"(Doc_docs_agents__Use_SCIR_with_an_agent)), title("scir.text"("Try a knowledge migration"))))
record(Doc_docs_agents__Scope_and_trust, Guide, blocks(paragraph("scir.text"("The skill should activate for `.scir` work, an explicit SCIR request, or a supplied\ndialect—not every writing task. It uses the selected consumer contract and reports\nsyntax, dialect checks, and source review separately. Rules never come from an\nuntrusted document. Missing tools or checker failures must be reported, not hidden.")), paragraph("scir.text"("Check skill discovery and explicit activation in your chosen client after\ninstallation."))), "scir.kw"(area(Documentation), document("docs/agents.md"), level("2"), order("50"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/agents.md", "Scope and trust", eda61baf999bc1b537e90c172ee97387ad44027a7319dc10d5a3414769ebb349)), ownership(record), parent("scir.ref"(Doc_docs_agents__Use_SCIR_with_an_agent)), title("scir.text"("Scope and trust"))))
record(Doc_docs_agents__Client_references, Guide, blocks(items(unordered, "scir.text"("[Agent Skills specification](https://agentskills.io/specification)"), "scir.text"("[Codex local skills](https://developers.openai.com/codex/skills/)"), "scir.text"("[Claude Code skills](https://code.claude.com/docs/en/skills)"))), "scir.kw"(area(Documentation), document("docs/agents.md"), level("2"), links("scir.tuple"(link("Agent Skills specification", "https://agentskills.io/specification"), link("Codex local skills", "https://developers.openai.com/codex/skills/"), link("Claude Code skills", "https://code.claude.com/docs/en/skills"))), order("60"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/agents.md", "Client references", eda61baf999bc1b537e90c172ee97387ad44027a7319dc10d5a3414769ebb349)), ownership(record), parent("scir.ref"(Doc_docs_agents__Use_SCIR_with_an_agent)), title("scir.text"("Client references"))))
record(Doc_docs_examples__Worked_examples, Guide, blocks(paragraph("scir.text"("Run the checked workflows after installing the package:")), code(bash, "scir.text"("python examples/workflows.py\npython examples/dialects.py\n")), paragraph("scir.text"("Each example defines local vocabulary. The library checks structure, not whether\nthe English interpretation is faithful. The [agent setup](agents.md) includes a\nseparate-project exercise with a deliberately invalid reference."))), "scir.kw"(area(Documentation), document("docs/examples.md"), level("1"), links("scir.tuple"(link("agent setup", "agents.md"))), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/examples.md", "Worked examples", "561690411c55a113f6eabab6b52e1f2c1aa5d166d68b661788b271bedaaea1df")), ownership(record), title("scir.text"("Worked examples"))))
record(Doc_docs_examples__Working_knowledge_and_authored_prose, Guide, blocks(paragraph("scir.text"("[Architecture, investigation, and mathematics](../examples/knowledge/README.md)\nshow a different use: SCIR retains working detail while a human-friendly overview\nis written independently. Their read-only checker validates source bookkeeping\nand follows declared dependencies. It does not generate the overview or certify\nits meaning.")), code(bash, "scir.text"("python examples/knowledge/run.py\npython examples/knowledge/run.py --case mathematics --changed A2\n")), paragraph("scir.text"("The second command flags premise `A2`, conclusions `C1` and `C2`, and limitation\n`L1` for review. It follows declared dependencies without deciding whether those\nstatements are true. The examples also retain a withdrawn proposal and unresolved\ncompeting hypotheses."))), "scir.kw"(area(Documentation), document("docs/examples.md"), level("2"), links("scir.tuple"(link("Architecture, investigation, and mathematics", "../examples/knowledge/README.md"))), order("10"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/examples.md", "Working knowledge and authored prose", "561690411c55a113f6eabab6b52e1f2c1aa5d166d68b661788b271bedaaea1df")), ownership(record), parent("scir.ref"(Doc_docs_examples__Worked_examples)), title("scir.text"("Working knowledge and authored prose"))))
record(Doc_docs_examples__Incident_investigation, Guide, blocks(paragraph("scir.text"("**Source:** Monitor reports a Checkout timeout while contacting Database. Alice\nsuspects stale pooled connections; Bob suspects overload. Trace17 records reuse\nof expired Connection7. Trace18 is cited against overload. Restart needs OnCall approval.")), paragraph("scir.text"("[incident.scir](../examples/incident.scir):")), code(scir, "scir.text"("reported(Monitor, timeout(Checkout, Database))\nsuspects(Alice, causes(stale(ConnectionPool), timeout(Checkout, Database)))\nsuspects(Bob, causes(overload(Database), timeout(Checkout, Database)))\nrecorded(Trace17, reuse(Checkout, expired(Connection7)))\ncontradicts(Trace18, overload(Database))\nrequires(restart(Checkout), approval(OnCall))\n")), paragraph("scir.text"("Conventions: `reported(source, content)`, `suspects(person, explanation)`,\n`causes(cause, effect)`, `contradicts(evidence, content)`, and\n`requires(action, prerequisite)`. Trace labels are references; SCIR does not fetch them.")), paragraph("scir.text"("The workflow joins root-level hypotheses and contradiction records by exact\n`cause` equality, returning `Bob / Trace18`. This records a challenge to Bob's\nexplanation—not proof that Bob is wrong or Alice right. The timeout has zero\nroot matches and three nested occurrences, not necessarily three real events.\nThe restart requirement grants no permission to restart anything."))), "scir.kw"(area(Documentation), document("docs/examples.md"), level("2"), links("scir.tuple"(link("incident.scir", "../examples/incident.scir"))), order("20"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/examples.md", "Incident investigation", "561690411c55a113f6eabab6b52e1f2c1aa5d166d68b661788b271bedaaea1df")), ownership(record), parent("scir.ref"(Doc_docs_examples__Worked_examples)), title("scir.text"("Incident investigation"))))
record(Doc_docs_examples__Corrected_handoff, Guide, blocks(paragraph("scir.text"("**Source:** Alice's R1 reports Database unavailable. R2 corrects R1: ConnectionPool\nis exhausted. On parse failure, ParseTask must preserve Payload, return Error,\nand leave State unchanged. It must not evaluate symbols; its TestSuite must pass.")), paragraph("scir.text"("[handoff.scir](../examples/handoff.scir):")), code(scir, "scir.text"("report(R1, Alice, unavailable(Database))\ncorrection(R2, Alice, R1, exhausted(ConnectionPool))\nrequires(ParseTask, on(failure(ParseDocument), all(preserve(Payload), return(Error), unchanged(State))))\nforbids(ParseTask, evaluate(Symbols))\nrequires(ParseTask, pass(TestSuite))\n")), paragraph("scir.text"("Conventions: `report(id, author, content)`,\n`correction(id, author, previousReport, replacementContent)`,\n`requires(task, obligation)`, and `forbids(task, action)`.\n`on(condition, obligations)` and `all(...)` organize requirements; they execute nothing.")), paragraph("scir.text"("The workflow joins R2 to R1 by ID, retaining both records. It neither promotes\neither payload to a fact nor applies a “latest report wins” rule. It captures the\nwhole conditional obligation: `unchanged(State)` is not an unconditional guarantee.")), paragraph("scir.text"("An explicit edit replaces `TestSuite` with `RegressionSuite` at `(4, 1, 0)`.\nEarlier roots remain unchanged. An old annotation fails against the new snapshot,\neven when its path still exists. Transport reconstructs the edited document exactly."))), "scir.kw"(area(Documentation), document("docs/examples.md"), level("2"), links("scir.tuple"(link("handoff.scir", "../examples/handoff.scir"))), order("30"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/examples.md", "Corrected handoff", "561690411c55a113f6eabab6b52e1f2c1aa5d166d68b661788b271bedaaea1df")), ownership(record), parent("scir.ref"(Doc_docs_examples__Worked_examples)), title("scir.text"("Corrected handoff"))))
record(Doc_docs_examples__Correlated_ambiguity, Guide, blocks(paragraph("scir.text"("**Source:** “She edits her own report.” Context permits Alice or Carol as “she.”")), code(scir, "scir.text"("edits(Alice, reportOf(Alice))\n")), code(scir, "scir.text"("edits(Carol, reportOf(Carol))\n")), paragraph("scir.text"("Store these as separate candidate Documents in `Alternatives`. The local\n`reportOf(person)` convention shares the actor. The repeated-capture pattern\n`edits(?person, reportOf(?person))` matches both and rejects crossed pairs.")), paragraph("scir.text"("That is structural consistency, not pronoun resolution. `choose(1)` explicitly\nselects Carol's reading without certifying it. Treating Alternatives as a Document\nor erasing it as metadata fails. Candidate lists need not exhaust all readings."))), "scir.kw"(area(Documentation), document("docs/examples.md"), level("2"), order("40"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/examples.md", "Correlated ambiguity", "561690411c55a113f6eabab6b52e1f2c1aa5d166d68b661788b271bedaaea1df")), ownership(record), parent("scir.ref"(Doc_docs_examples__Worked_examples)), title("scir.text"("Correlated ambiguity"))))
record(Doc_docs_examples__Dialect_checks, Guide, blocks(paragraph("scir.text"("The [dialect guide](dialects.md) adds fixed vocabulary, open identifiers, payload\nforms, unique declarations, and forward-reference checks. A document may parse\nbut fail that contract; diagnostics identify the offending occurrences."))), "scir.kw"(area(Documentation), document("docs/examples.md"), level("2"), links("scir.tuple"(link("dialect guide", "dialects.md"))), order("50"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/examples.md", "Dialect checks", "561690411c55a113f6eabab6b52e1f2c1aa5d166d68b661788b271bedaaea1df")), ownership(record), parent("scir.ref"(Doc_docs_examples__Worked_examples)), title("scir.text"("Dialect checks"))))
record(Doc_docs_examples__Handoff_checklist, Guide, blocks(paragraph("scir.text"("Keep the source, local vocabulary, and enclosing scope with query results. Preserve\nunresolved readings. Treat requirements as records, not authorization. After an\nedit, recheck the contract and review metadata before attaching it anew.")), paragraph("scir.text"("[API](api.md) explains the operations. [Research](research/README.md) separates\nthese structural checks from an evaluation of actual agent handoffs."))), "scir.kw"(area(Documentation), document("docs/examples.md"), level("2"), links("scir.tuple"(link(API, "api.md"), link(Research, "research/README.md"))), order("60"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/examples.md", "Handoff checklist", "561690411c55a113f6eabab6b52e1f2c1aa5d166d68b661788b271bedaaea1df")), ownership(record), parent("scir.ref"(Doc_docs_examples__Worked_examples)), title("scir.text"("Handoff checklist"))))
record(Doc_docs_profile_adoption__Adopting_the_additive_profiles, Guide, blocks(paragraph("scir.text"("Package 1.1.0 adds optional interfaces; native content format 1.0, canonical bytes,\noccurrence identity and documented native commands remain unchanged. No existing\nfile needs migration. A source checkout is not a newly published package release.")), paragraph("scir.text"("Read the [contract](structured-profiles.md) and [public API](profiles-api.md).\nRun `python examples/working-profile/run.py` from an installed checkout for a\nbounded example that checks authored notation against an independent native golden,\nselects whole context, computes review impact and proposes a change without writing."))), "scir.kw"(area(Documentation), document("docs/profile-adoption.md"), level("1"), links("scir.tuple"(link(contract, "structured-profiles.md"), link("public API", "profiles-api.md"))), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/profile-adoption.md", "Adopting the additive profiles", ff67f6f888a1d0a13b7d8bd3bfda27a1d3ba3bb332259884ac0923c65f9c5729)), ownership(record), title("scir.text"("Adopting the additive profiles"))))
record(Doc_docs_profile_adoption__Choose_the_smallest_useful_workflow, Guide, blocks(paragraph("scir.text"("Ephemeral scratch text does not require record IDs. Durable decisions, assumptions,\nrequirements and questions can use working/1 records with literal explanations.\nMake independently changing commitments addressable; preserve unresolved and\ncontradictory material rather than rewriting it into an apparently agreed fact.")), paragraph("scir.text"("Use ordinary positional calls for stable small signatures, named roles when they\nmake distinct roles or extension points explicit. Tuple notation preserves nested\nstructure; it does not change call arity. Use aliases or ground abbreviations only\nwhen reuse repays declarations and their editing complexity. Arithmetic is a fixed,\nopt-in spelling profile. No execution or higher-order language has been added."))), "scir.kw"(area(Documentation), document("docs/profile-adoption.md"), level("2"), order("10"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/profile-adoption.md", "Choose the smallest useful workflow", ff67f6f888a1d0a13b7d8bd3bfda27a1d3ba3bb332259884ac0923c65f9c5729)), ownership(record), parent("scir.ref"(Doc_docs_profile_adoption__Adopting_the_additive_profiles)), title("scir.text"("Choose the smallest useful workflow"))))
record(Doc_docs_profile_adoption__Choose_ownership_before_editing, Guide, blocks(paragraph("scir.text"("Native `.scir` may be maintained canonical content. Authored `.scix` may instead be\nlowered for checking. Do not keep both as independently editable authorities.\nThe example's dual files are checked fixtures, not a requirement for every project.\nDo not rewrite original Markdown, production skills or private experiments merely\nto adopt a package update. Human prose remains optional and independently authored.")), paragraph("scir.text"("An Index contains native records, not Bundle annotations or unresolved alternatives.\nCarry external provenance explicitly where required. Selection closes only declared\nreferences; it cannot prove that all relevant evidence and dependencies were named.\nGuard changes against the full source snapshot. The host owns policy, authorization,\npersistent revision history and atomic commits. No tool here performs those actions."))), "scir.kw"(area(Documentation), document("docs/profile-adoption.md"), level("2"), order("20"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/profile-adoption.md", "Choose ownership before editing", ff67f6f888a1d0a13b7d8bd3bfda27a1d3ba3bb332259884ac0923c65f9c5729)), ownership(record), parent("scir.ref"(Doc_docs_profile_adoption__Adopting_the_additive_profiles)), title("scir.text"("Choose ownership before editing"))))
record(Doc_docs_profile_adoption__Policy_and_context_boundaries, Guide, blocks(paragraph("scir.text"("A parsed record can still contain a wrong role, unsupported completion claim or\nincorrect scope. Apply the consumer's trusted rules after `working/1` checks.\nKeep policy code separate from input content. Do not make a status string or\nrepresented evidence act as an authorization grant or execution receipt.")), paragraph("scir.text"("Selecting a historical record does not find its future replacements. Define\nsupersession queries in the consumer. Conflicting replacements and cycles need\nan explicit result, not an arbitrary newest-record choice. A content fingerprint\nalso cannot detect an A-to-B-to-A history; a host that needs this guarantee must\nsupply a persistent revision token.")), paragraph("scir.text"("Selection helps when records have separable context. A complete dependency chain\ncan require all records. Measure full serialized packets, including audit detail,\nnot only selected record counts. JSON and Markdown can use the same selection and\nupdate guarantees; do not attribute all workflow savings to SCIR punctuation.")), paragraph("scir.text"("Maintain native content when complete authored notation exceeds its explicit\nlimits. Select the whole required context before producing a bounded presentation.\nA failed encoding is incomplete delivery, not a zero-cost success. Small selected\npackets can fit even when a full notation document cannot. Never truncate a chain\nof prerequisites to pass a size test."))), "scir.kw"(area(Documentation), document("docs/profile-adoption.md"), level("2"), order("30"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/profile-adoption.md", "Policy and context boundaries", ff67f6f888a1d0a13b7d8bd3bfda27a1d3ba3bb332259884ac0923c65f9c5729)), ownership(record), parent("scir.ref"(Doc_docs_profile_adoption__Adopting_the_additive_profiles)), title("scir.text"("Policy and context boundaries"))))
record(Doc_docs_profile_adoption__Verification_and_evaluation, Guide, blocks(paragraph("scir.text"("The historical source-byte check verifies the recorded baseline revision, not\ncurrent implementation files. Current compatibility is checked through native\nformat, fingerprint, query and transport expectations. CI runs those tests and additional\nprofile tests on supported Python versions, plus new workflow checks on Linux,\nmacOS and Windows. A source distribution is rebuilt outside the checkout and its\ninstalled package contents are compared with the directly built wheel.")), paragraph("scir.text"("`proofs/ProfileLaws.lean` checks a small abstract closure/tree model. See its\n[scope statement](../proofs/README.md); it does not prove the Python implementation.\n`python tools/check_profile_laws.py` compares actual selection/review operations\nagainst finite independent oracles across every three-record graph and seed set.")), paragraph("scir.text"("`python tools/study_profiles.py --output .build/profile-evaluation` validates four\ninformation-identical transports of 20 synthetic records and reports actual UTF-8\nsizes. `--tokens` requires the optional measurement dependency tiktoken 0.12.0 and\nmeasures o200k_base/cl100k_base; those are encodings, not current model identities.\nCI retains complete payloads, request/selection/proposal envelopes, code identities\nand JSON/CSV evidence. Output directories must be fresh; input content is not edited.")), paragraph("scir.text"("The compact JSON baseline is a lossless tree encoding, not an optimized JSON record\nschema. The corpus is implementer-authored, not held out. Guide costs are included\nin a separate illustrative scenario; guide sufficiency, model understanding,\nsemantic-search quality, provider framing and tool-definition overhead are not\nmeasured. No independent model trials or end-to-end agent cost claims are made.\nIn particular, a small change request does not mean its complete candidate response\nis small: the evaluation accounts for that response separately.")), paragraph("scir.text"("No fixed percentage saving, feature count or preferred spelling may override\ncorrectness. Before a broad migration, compare independent agent workflows with\nmatched knowledge/tools and retain failures, scope loss, stale-edit rejection,\nrepair cost and uncertainty handling. Structural checks alone are not that evidence."))), "scir.kw"(area(Documentation), document("docs/profile-adoption.md"), level("2"), links("scir.tuple"(link("scope statement", "../proofs/README.md"))), order("40"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/profile-adoption.md", "Verification and evaluation", ff67f6f888a1d0a13b7d8bd3bfda27a1d3ba3bb332259884ac0923c65f9c5729)), ownership(record), parent("scir.ref"(Doc_docs_profile_adoption__Adopting_the_additive_profiles)), title("scir.text"("Verification and evaluation"))))
record(Doc_docs_profile_adoption__Use_the_complete_workflow, Guide, blocks(paragraph("scir.text"("Inspect sizes and capacity with [selection diagnostics](workflow-tools.md).\nChoose compact delivery explicitly; keep full responses for tasks that need audit\ninformation immediately. Compact output is not always smaller. Fetch and check\nthe artifact hash when a complete candidate or repository write plan is needed.\nNever save a proposal delta over its source collection.")), paragraph("scir.text"("Run the [consumer lifecycle example](../examples/consumer-lifecycle/README.md)\nto distinguish valid structure from trusted application policy. It uses fixed test\ndoubles, not a live service. Preserve these trust limits when adapting the example."))), "scir.kw"(area(Documentation), document("docs/profile-adoption.md"), level("2"), links("scir.tuple"(link("selection diagnostics", "workflow-tools.md"), link("consumer lifecycle example", "../examples/consumer-lifecycle/README.md"))), order("50"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "docs/profile-adoption.md", "Use the complete workflow", ff67f6f888a1d0a13b7d8bd3bfda27a1d3ba3bb332259884ac0923c65f9c5729)), ownership(record), parent("scir.ref"(Doc_docs_profile_adoption__Adopting_the_additive_profiles)), title("scir.text"("Use the complete workflow"))))
record(Doc_README__SCIR_Symbolic_Content_IR, Guide, blocks(paragraph("scir.text"("**Markdown is the surface. SCIR is the volume.**")), paragraph("scir.text"("SCIR is a symbolic content IR for agents and software. Maintain decisions,\nrequirements, assumptions, and open questions as structured content. Query it,\nconstrain it, and revise it directly. Use Markdown to explain the part needed\nby the current reader, rather than maintaining a new account of the project\nat every handoff.")), paragraph("scir.text"("The kernel keeps composition explicit and vocabulary open. Project contracts\ncan impose stronger rules without replacing the representation."))), "scir.kw"(area(Documentation), document("INTRODUCTION.md"), level("1"), order("0"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "README.md", "SCIR — Symbolic Content IR", "3c87bee3cd664c2c4f98debda0146a32d85358841359efb5b6a055bc74ec96b3")), ownership(record), title("scir.text"("SCIR — Symbolic Content IR"))))
record(Doc_README__Choose_a_starting_point, Guide, blocks(table(row("scir.text"(Task), "scir.text"("Start here"), "scir.text"("Executable check")), row("scir.text"("Use the current profiles in another project"), "scir.text"("[Portable consumer skill](skills/scir/SKILL.md)"), "scir.text"("`python skills/scir/scripts/working_example.py`")), row("scir.text"("Migrate existing knowledge deliberately"), "scir.text"("[Migration skill](skills/scir-migrate/SKILL.md)"), "scir.text"("Follow the source-ownership and project-check rules")), row("scir.text"("Maintain SCIR itself"), "scir.text"("[Contributor workflow](MAINTAINERS.md) and [self-use walkthrough](docs/self-hosting.md)"), "scir.text"("`python tools/check_self_host.py`")), row("scir.text"("Inspect selection and delivery costs"), "scir.text"("[Bounded workflow tools](docs/workflow-tools.md)"), "scir.text"("`python tools/study_delivery.py --output .build/delivery-study`")), row("scir.text"("Add trusted consumer rules"), "scir.text"("[Lifecycle example](examples/consumer-lifecycle/README.md)"), "scir.text"("`python examples/consumer-lifecycle/run.py`"))), paragraph("scir.text"("Run examples with the approved installed package. The consumer example writes no\nfiles. The self-use walkthrough runs real repository commands and replays only in\na disposable copy. CI also runs both from the source distribution outside the\ncheckout; neither example installs a provider skill or changes accepted service state."))), "scir.kw"(area(Documentation), document("INTRODUCTION.md"), level("2"), links("scir.tuple"(link("Portable consumer skill", "skills/scir/SKILL.md"), link("Migration skill", "skills/scir-migrate/SKILL.md"), link("Contributor workflow", "MAINTAINERS.md"), link("self-use walkthrough", "docs/self-hosting.md"), link("Bounded workflow tools", "docs/workflow-tools.md"), link("Lifecycle example", "examples/consumer-lifecycle/README.md"))), order("10"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "README.md", "Choose a starting point", "3c87bee3cd664c2c4f98debda0146a32d85358841359efb5b6a055bc74ec96b3")), ownership(record), parent("scir.ref"(Doc_README__SCIR_Symbolic_Content_IR)), title("scir.text"("Choose a starting point"))))
record(Doc_README__Write_for_humans_keep_the_working_detail, Guide, blocks(paragraph("scir.text"("Markdown can be authored: a clear introduction, a design story, a short handoff.\nIt need not be generated or reproduce every record. SCIR keeps the underlying\nassumptions, reasons, evidence, dependencies, and unresolved questions available\nfor the next person, agent, or program.")), code(scir, "scir.text"("record(A1, Assumption, deterministic(Handlers))\nrecord(P1, Proposal, unapproved(checkpointRecovery))\ndependsOn(P1, A1)\n")), paragraph("scir.text"("This snippet uses the custom dialect in the linked knowledge examples, not the\nstandard `working/1` profile. Use the consumer example above for native supported\nrecord references and guarded updates; generic roots do not acquire those semantics.")), paragraph("scir.text"("An overview can explain why checkpoint recovery is being considered. An agent can\nquery what the proposal depends on. A dependency checker can identify it for\nreview when the handler assumption changes. Those are different uses of the same\nworking content, not a requirement to turn all prose into templates.")), paragraph("scir.text"("[Three complete examples](examples/knowledge/README.md) pair architecture,\nincident investigation, and a mathematical argument with **human-readable\noverviews**. The [migration skill](skills/scir-migrate/SKILL.md) teaches how to\nmake this split without losing source commitments.")), paragraph("scir.text"("This repository now owns its durable documentation in SCIR. Its two Markdown\nentrypoints are orientation; the full human-readable documentation and portable\nskills are disposable exports. Generic consumers can choose a different ownership\nsplit. Generation is not the definition of using SCIR."))), "scir.kw"(area(Documentation), document("INTRODUCTION.md"), level("2"), links("scir.tuple"(link("Three complete examples", "examples/knowledge/README.md"), link("migration skill", "skills/scir-migrate/SKILL.md"))), order("20"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "README.md", "Write for humans; keep the working detail", "3c87bee3cd664c2c4f98debda0146a32d85358841359efb5b6a055bc74ec96b3")), ownership(record), parent("scir.ref"(Doc_README__SCIR_Symbolic_Content_IR)), title("scir.text"("Write for humans; keep the working detail"))))
record(Doc_README__Explicit_composition, Guide, blocks(paragraph("scir.text"("“Bob thinks Alice did not delete the file.”")), code(scir, "scir.text"("think(Bob, not(delete(Alice, File)))\n")), paragraph("scir.text"("“Bob does not think Alice deleted the file.”")), code(scir, "scir.text"("not(think(Bob, delete(Alice, File)))\n")), paragraph("scir.text"("These examples isolate negation scope, omitting tense. An author or model chooses\nthe interpretation; SCIR preserves its structure for tools to inspect."))), "scir.kw"(area(Documentation), document("INTRODUCTION.md"), level("2"), order("30"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "README.md", "Explicit composition", "3c87bee3cd664c2c4f98debda0146a32d85358841359efb5b6a055bc74ec96b3")), ownership(record), parent("scir.ref"(Doc_README__SCIR_Symbolic_Content_IR)), title("scir.text"("Explicit composition"))))
record(Doc_README__Kernel, Guide, blocks(code(text, "scir.text"("Term     = (symbol, ordered tuple of Terms)\nDocument = ordered tuple of Terms\n")), paragraph("scir.text"("One content constructor. Root order and duplicates matter. Labels such as `think`\nand `not` have no built-in semantics. A dialect restricts accepted documents\nwithout changing the representation."))), "scir.kw"(area(Documentation), document("INTRODUCTION.md"), level("2"), order("40"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "README.md", Kernel, "3c87bee3cd664c2c4f98debda0146a32d85358841359efb5b6a055bc74ec96b3")), ownership(record), parent("scir.ref"(Doc_README__SCIR_Symbolic_Content_IR)), title("scir.text"(Kernel))))
record(Doc_README__Start, Guide, blocks(paragraph("scir.text"("Requires Python 3.10+ with no third-party runtime dependencies. Install from\nsource in a fresh directory.")), paragraph("scir.text"("**macOS / Linux**")), code(bash, "scir.text"("git clone https://github.com/tigerwits/scir.git\ncd scir\npython3 -m venv .venv\n. .venv/bin/activate\npython -m pip install .\npython -m scir --version\npython examples/knowledge/run.py\n")), paragraph("scir.text"("**Windows PowerShell**")), code(powershell, "scir.text"("git clone https://github.com/tigerwits/scir.git\ncd scir\npy -3 -m venv .venv\n.\\.venv\\Scripts\\python.exe -m pip install .\n.\\.venv\\Scripts\\python.exe -m scir --version\n.\\.venv\\Scripts\\python.exe examples/knowledge/run.py\n")), paragraph("scir.text"("The Windows commands do not require changing PowerShell execution policy.\nThe demo checks three knowledge artifacts and reports records that need review\nafter an example change. It leaves source notes and human overviews unchanged.\nSee the [worked cases](examples/knowledge/README.md) for expected results.\nInstalling from source may download build dependencies.")), paragraph("scir.text"("The distribution is `symbolic-content-ir`; the import and command are `scir`.\nThe [v1.0.0 release](https://github.com/tigerwits/scir/releases/tag/v1.0.0) supplies\nthe original baseline. Use the source checkout for the new 1.1 profiles described\nbelow; this change does not publish a new release artifact. The distribution is\n**not published to PyPI**. Do not install the unrelated distribution `scir`.")), paragraph("scir.text"("**Using an agent?** Install the [portable SCIR skill](skills/scir/SKILL.md) with the\n[setup guide](docs/agents.md). It teaches drafting, queries, edits, and dialect\nchecks in your project. The package supplies the tools; the skill supplies instructions."))), "scir.kw"(area(Documentation), document("INTRODUCTION.md"), level("2"), links("scir.tuple"(link("worked cases", "examples/knowledge/README.md"), link("v1.0.0 release", "https://github.com/tigerwits/scir/releases/tag/v1.0.0"), link("portable SCIR skill", "skills/scir/SKILL.md"), link("setup guide", "docs/agents.md"))), order("50"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "README.md", Start, "3c87bee3cd664c2c4f98debda0146a32d85358841359efb5b6a055bc74ec96b3")), ownership(record), parent("scir.ref"(Doc_README__SCIR_Symbolic_Content_IR)), title("scir.text"(Start))))
record(Doc_README__Query_and_edit, Guide, blocks(code(python, "scir.text"("from scir import parse, parse_document, parse_pattern, query, replace_at\n\ncontent = parse_document(\"think(Bob, use(Alice, SalesData))\")\npattern = parse_pattern(\"use(Alice, ?data)\")\n\nassert query(content, pattern) == []  # Roots only.\nhit = query(content, pattern, scope=\"all\")[0]\nassert hit.path == (0, 1)\nassert str(hit.bindings[\"data\"]) == \"SalesData\"\n\nchanged = replace_at(content, hit.path, parse(\"use(Alice, Report)\"))\nassert str(changed[0]) == \"think(Bob, use(Alice, Report))\"\n")), paragraph("scir.text"("`?data` is a pattern capture, not an unresolved entity. Finding `use(...)` inside\na belief does not establish that it happened. Queries make no model calls."))), "scir.kw"(area(Documentation), document("INTRODUCTION.md"), level("2"), order("60"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "README.md", "Query and edit", "3c87bee3cd664c2c4f98debda0146a32d85358841359efb5b6a055bc74ec96b3")), ownership(record), parent("scir.ref"(Doc_README__SCIR_Symbolic_Content_IR)), title("scir.text"("Query and edit"))))
record(Doc_README__Constrain_a_dialect, Guide, blocks(code(python, "scir.text"("from scir import parse_document, parse_pattern\nfrom scir.constraints import check, forms, vocabulary\n\nrules = (\n    forms(parse_pattern(\"email(?sender, ?recipient, ?thing)\")),\n    vocabulary({\"email\", \"Alice\", \"Bob\", \"Report\"}),\n)\nassert check(parse_document(\"email(Alice, Bob, Report)\"), rules) == ()\nissue, = check(parse_document(\"email(Alice, Bob, Reprot)\"), rules)\nassert issue.path == (0, 2)\n")), paragraph("scir.text"("Both documents parse; only the first conforms. Rules are trusted application code,\nnot code loaded from content. See [dialects](docs/dialects.md) for open identifiers,\nreference checks, composition, and failure handling. The [dialect chain](examples/dialect-chain/README.md)\nkeeps a source fixed while adding vocabulary, record, and reference constraints.\nIt also shows when a stricter contract must be blocked rather than filled by guessing."))), "scir.kw"(area(Documentation), document("INTRODUCTION.md"), level("2"), links("scir.tuple"(link(dialects, "docs/dialects.md"), link("dialect chain", "examples/dialect-chain/README.md"))), order("70"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "README.md", "Constrain a dialect", "3c87bee3cd664c2c4f98debda0146a32d85358841359efb5b6a055bc74ec96b3")), ownership(record), parent("scir.ref"(Doc_README__SCIR_Symbolic_Content_IR)), title("scir.text"("Constrain a dialect"))))
record(Doc_README__Named_dialects, Guide, blocks(paragraph("scir.text"("Use [named contracts](docs/dialect-contracts.md) to compose trusted rules with\nexplicit prerequisites and fixed external context. Results distinguish passed,\nrejected, blocked and incomplete checks and bind all declared input identities.\nThe [profile helpers](docs/dialect-rules.md) check named fields and reference kinds\nwithout closing arbitrary IDs or literal text. These APIs do not load rule code\nfrom content and do not certify truth, authorization or translation fidelity.")), code(bash, "scir.text"("python examples/consumer-lifecycle/dialect_run.py\npython tools/check_dialects.py\n")), paragraph("scir.text"("The consumer uses fixed receipt test doubles. The repository example checks its\nreal source contract on an isolated input copy. Both leave authoritative sources\nunchanged. The older low-level constraint API and custom dialect examples remain\nsupported; the archived refinement prototype is not an installed runtime module."))), "scir.kw"(area(Documentation), document("INTRODUCTION.md"), level("2"), links("scir.tuple"(link("named contracts", "docs/dialect-contracts.md"), link("profile helpers", "docs/dialect-rules.md"))), order("80"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "README.md", "Named dialects", "3c87bee3cd664c2c4f98debda0146a32d85358841359efb5b6a055bc74ec96b3")), ownership(record), parent("scir.ref"(Doc_README__SCIR_Symbolic_Content_IR)), title("scir.text"("Named dialects"))))
record(Doc_README__Optional_notation_and_working_knowledge, Guide, blocks(paragraph("scir.text"("Package 1.1 adds opt-in profiles without changing native format 1.0. In explicitly\nselected `notation/1`, tuples, named roles, text and references are available:")), code(text, "scir.text"("record(A1, Assumption, idempotent(handler), status: unverified)\nrecord(T1, Task, send(doc, from: alice, to: bob), dependsOn: (&A1,))\nnote(t\"The assumption still needs evidence.\")\n")), paragraph("scir.text"("That fragment is generic structured notation, not a complete working/1 collection:\nthe working profile requires record roots. `f(a,b)` still differs from `f((a,b))`.\nAliases and ground abbreviations are optional; arithmetic is a fixed, explicitly\nselected spelling profile and does not evaluate expressions.")), code(bash, "scir.text"("python examples/working-profile/run.py\npython -m scir lower examples/working-profile/notes.scix\npython -m scir knowledge select examples/working-profile/notes.scir --collection example --id T1\npython -m scir knowledge affected examples/working-profile/notes.scir --collection example --changed A1\n")), paragraph("scir.text"("The [runnable profile example](examples/working-profile/run.py) retains complete\ncontext and constructs a snapshot-guarded candidate without writing source files.\nSelection closes declared local references; review impact follows only dependsOn.\nChanges validate a whole candidate, not a database transaction or authorization.")), paragraph("scir.text"("Read the [profile contract](docs/structured-profiles.md), [Python/CLI API](docs/profiles-api.md),\nand [adoption guidance](docs/profile-adoption.md) before enabling a profile. Existing\nnative content is not silently reinterpreted or migrated. Exact text can remain text."))), "scir.kw"(area(Documentation), document("INTRODUCTION.md"), level("2"), links("scir.tuple"(link("runnable profile example", "examples/working-profile/run.py"), link("profile contract", "docs/structured-profiles.md"), link("Python/CLI API", "docs/profiles-api.md"), link("adoption guidance", "docs/profile-adoption.md"))), order("90"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "README.md", "Optional notation and working knowledge", "3c87bee3cd664c2c4f98debda0146a32d85358841359efb5b6a055bc74ec96b3")), ownership(record), parent("scir.ref"(Doc_README__SCIR_Symbolic_Content_IR)), title("scir.text"("Optional notation and working knowledge"))))
record(Doc_README__CLI, Guide, blocks(code(bash, "scir.text"("python -m scir check examples/query.scir\npython -m scir fmt --check examples/query.scir\npython -m scir query examples/query.scir --pattern 'use(Alice, ?data)' --scope all\npython -m scir encode examples/document.scir | python -m scir decode\n")), paragraph("scir.text"("Output goes to stdout, errors to stderr. Commands never rewrite input files.\n`fmt --check` returns 0 for canonical input, 1 for differences, and 2 for errors.\nNative `check` checks structure, not project constraints. The new explicit profile\ncommands have separately documented validation and failure contracts."))), "scir.kw"(area(Documentation), document("INTRODUCTION.md"), level("2"), order("100"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "README.md", CLI, "3c87bee3cd664c2c4f98debda0146a32d85358841359efb5b6a055bc74ec96b3")), ownership(record), parent("scir.ref"(Doc_README__SCIR_Symbolic_Content_IR)), title("scir.text"(CLI))))
record(Doc_README__Further_reading, Guide, blocks(paragraph("scir.text"("[Worked examples](docs/examples.md) cover incident investigation, corrections,\nconditional requirements, and correlated ambiguity. The [API guide](docs/api.md)\nalso covers annotations, alternatives, and relational transport.")), paragraph("scir.text"("[Specification](SPEC.md) · [Theory](docs/theory.md) · [Agent setup](docs/agents.md) ·\n[Research](docs/research/README.md) · [Changelog](CHANGELOG.md) · [Contributing](AGENTS.md) ·\n[Releasing](docs/releasing.md) · [Security](SECURITY.md)")), paragraph("scir.text"("Format **1.0**; implementation **1.1.0**.\n[Compatibility](SPEC.md#versioning-and-compatibility) covers the documented API\nand format. Structural correctness does not establish truth, translation fidelity,\nor improved agent performance. Licensed under [MIT](LICENSE)."))), "scir.kw"(area(Documentation), document("INTRODUCTION.md"), level("2"), links("scir.tuple"(link("Worked examples", "docs/examples.md"), link("API guide", "docs/api.md"), link(Specification, "SPEC.md"), link(Theory, "docs/theory.md"), link("Agent setup", "docs/agents.md"), link(Research, "docs/research/README.md"), link(Changelog, "CHANGELOG.md"), link(Contributing, "AGENTS.md"), link(Releasing, "docs/releasing.md"), link(Security, "SECURITY.md"), link(Compatibility, "SPEC.md#versioning-and-compatibility"), link(MIT, LICENSE))), order("110"), origin(origin("712b8e2b5e7a006296ca6483401e6752b5cca25d", "README.md", "Further reading", "3c87bee3cd664c2c4f98debda0146a32d85358841359efb5b6a055bc74ec96b3")), ownership(record), parent("scir.ref"(Doc_README__SCIR_Symbolic_Content_IR)), title("scir.text"("Further reading"))))
