record(KeepNativeKernel, Decision, preserve(nativeFormat), "scir.kw"(area(Core), ownership(index), reason("scir.text"("Add optional profiles without changing native grammar, equality, canonical bytes, digests or transport.")), source(section("docs/structured-profiles.md", "Layer boundaries")), status(adopted)))
