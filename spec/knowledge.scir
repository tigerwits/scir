record(OptionalRoles, Decision, optional(namedRoles), "scir.kw"(area(Notation), ownership(index), reason("scir.text"("Use roles when ambiguity or extensibility warrants them; measured token costs do not establish agent accuracy.")), source(section("docs/profile-results.md", "Adoption decision and limits")), status(adopted)))
record(ConservativeSnapshots, Decision, guard(wholeSourceSnapshot), "scir.kw"(area(Changes), ownership(index), reason("scir.text"("Any source-content change invalidates a proposal, including a changed assumption outside the edited record.")), source(section("docs/structured-profiles.md", "Guarded changes")), status(adopted)))
record(OptionalNotation, Decision, selectByCaller(notationEnvironment), "scir.kw"(area(Notation), dependsOn("scir.tuple"("scir.ref"(KeepNativeKernel))), ownership(index), reason("scir.text"("A filename or document cannot select a parser, import code, or grant authorization.")), source(section("docs/structured-profiles.md", "Layer boundaries")), status(adopted)))
record(ModelProofBoundary, Limitation, excludes(pythonProof, storageConcurrency, agentQuality), "scir.kw"(area(Evidence), ownership(index), reason("scir.text"("The nine Lean theorems cover an abstract closure/tree model, not the Python parser, UTF-8 codec, field sorting, resource limits or source fidelity.")), source(section("docs/profile-results.md", "Structural verification"))))
record(DeclaredEdgesOnly, Limitation, completeRelativeTo(authoredReferences), "scir.kw"(area(Working), ownership(index), reason("scir.text"("Selection follows declared outgoing references, not semantic relevance or future replacements. Citations are not review dependencies. Status and represented evidence do not prove execution or authority.")), source(section("docs/structured-profiles.md", "Consumer boundaries"))))
record(NoAgentTrials, Limitation, unmeasured(independentAgentPerformance), "scir.kw"(area(Evidence), ownership(index), reason("scir.text"("The retained synthetic measurements are not independent model trials or evidence of better reasoning.")), source(section("docs/profile-results.md", "Adoption decision and limits"))))
record(HostPersistence, Limitation, requires(hostAtomicCommit), "scir.kw"(area(Changes), ownership(index), reason("scir.text"("Candidate construction performs no persistent write. Hosts enforce commit preconditions and stronger policies; content hashes do not detect A-to-B-to-A history.")), source(section("docs/structured-profiles.md", "Guarded changes"))))
