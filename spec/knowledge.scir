record(SelfOwnedContracts, Requirement, own(exactContractInSCIR), "scir.kw"(area(Workflow), contract("scir.text"("A repository record may own a nonempty contract text directly in spec/knowledge.scir or spec/native.scir. It uses ownership(record), source(scir.ref(its own ID)), and contract(scir.text(exact wording)). This is a scoped extension of scir-repository/1 over the existing working/1 fields and explicit references. An indexed or document-owned record cannot also carry contract text. Self-owned contracts cannot carry native query-view fields or projection; the six existing query owners keep their current view contract. Existing requirements still need independent test locations; model locations are checked statically. Source membership binds the owning shard bytes in repository handoffs. Newly created IDs require explicit shard placement and stale input bases reject proposals. Selection of the self-reference terminates under the existing reference closure. Validation checks shapes and declared links, not truth, test adequacy, execution or permission.")), ownership(record), source("scir.ref"(SelfOwnedContracts)), tests("scir.tuple"(test("tests/test_repository_knowledge.py", "RepositoryKnowledgeTests.test_self_owned_contracts_have_exact_local_identity_and_checked_links"), test("tests/test_repository_handoff.py", "RepositoryHandoffTests.test_self_owned_contract_creation_binds_source_bytes_and_requires_placement")))))
record(SymbolValues, Requirement, expressionsOver(exactSymbols), "scir.kw"(area(Core), contract("scir.text"("Symbol(value: str) is an immutable, hashable native label value. Its value is exactly one nonempty Unicode scalar string under the existing check_symbol rule; no normalization, case folding, interning identity or referent is implied. str(Symbol(s)) uses existing native symbol quoting. Terms remain finite ordered rose trees T(S) = S x List(T(S)); documents remain ordered lists of terms. A label can head zero or any positive number of children. Symbol(s) is distinct from the leaf Term(s), a pattern variable and a working/1 reference. Term(symbol: str | Symbol, args: tuple[Term, ...] = ()) and patterns.Node(symbol: str | Symbol, args: tuple[Pattern, ...] = ()) normalize their constructor head to the existing symbol: str field. Their head accessor returns Symbol(symbol). Existing string constructors, structural equality, hashes, formatting, digests, native grammar and transports retain their behavior. This additive Python API was introduced in implementation version 1.2.0; native FORMAT_VERSION remains 1.0. Symbol values alone do not define variable substitution, operator replacement, macro expansion or entity resolution.")), dependsOn("scir.tuple"("scir.ref"(KeepNativeKernel), "scir.ref"(SelfOwnedContracts))), ownership(record), source("scir.ref"(SymbolValues)), tests("scir.tuple"(test("tests/test_symbols.py", "SymbolTests.test_symbol_value_and_legacy_constructor_boundary"), test("tests/test_symbols.py", "SymbolTests.test_exact_unicode_and_quoting"), test("tests/test_kernel.py", "SyntaxTests.test_quoted_symbols")))))
record(SymbolRelabeling, Requirement, relabel(simultaneous, orderedOccurrences), "scir.kw"(area(Tree), contract("scir.text"("symbol_occurrences(document: Document) returns a tuple of (Path, Symbol) pairs in the existing preorder walk, retaining every root and child position, duplicate occurrence and arbitrary head arity. Paths identify occurrences in that document, not stable referents. relabel_symbols(document: Document, renaming: Mapping[str | Symbol, str | Symbol]) returns a fresh structural document, replacing each original head once using the finite mapping and leaving unmapped heads unchanged. Map inputs use exact valid symbol values; duplicate keys after string/Symbol normalization reject. Values are immutable and source documents are not edited. For total label functions extended by identity outside each finite map, R_id(d) = d; R_g(R_f(d)) = R_(g composed with f)(d); Occ(R_f(d)) = map((path,s) -> (path,f(s)), Occ(d)). Ordered child structure, root order, arity and occurrence multiplicity are preserved. This is global native relabeling: it also visits profile tags, text-body leaf labels, reference IDs, record IDs and field names. Core validity does not imply working/1 or another dialect remains valid; validate that profile after a deliberate relabel. Noninjective maps may collapse different labels and can turn a failed repeated-variable match into a success. Relabeling does not splice a tree into an applied head or infer an operator-substitution policy.")), dependsOn("scir.tuple"("scir.ref"(SymbolValues))), models("scir.tuple"(model("proofs/SymbolLaws.lean", relabel_identity), model("proofs/SymbolLaws.lean", relabel_composition), model("proofs/SymbolLaws.lean", occurrence_preservation), model("proofs/SymbolLaws.lean", document_identity), model("proofs/SymbolLaws.lean", document_composition), model("proofs/SymbolLaws.lean", document_occurrence_preservation))), ownership(record), source("scir.ref"(SymbolRelabeling)), tests("scir.tuple"(test("tests/test_symbols.py", "SymbolTests.test_occurrences_retain_order_duplicates_and_arities"), test("tests/test_symbols.py", "SymbolTests.test_relabeling_is_simultaneous_and_changes_heads_and_leaves"), test("tests/test_symbols.py", "SymbolTests.test_composition_and_occurrence_naturality"), test("tests/test_symbols.py", "SymbolTests.test_invalid_mapping_and_normalized_duplicate_keys_fail"), test("tests/test_symbols.py", "SymbolTests.test_native_relabeling_does_not_imply_profile_preservation"), test("tests/test_symbols.py", "SymbolTests.test_noninjective_relabeling_does_not_preserve_match_failure")))))
record(SymbolReferenceBoundary, Limitation, separate(provedModel, testedRuntime), "scir.kw"(area(Evidence), contract("scir.text"("proofs/SymbolLaws.lean independently states the structural Relabeled relation and proves its recursive reference sound and complete for finite ordered trees over an arbitrary label type. It proves relabeling identity, composition and occurrence naturality for trees and documents; helper laws are included in the audit. tools/check_symbol_reference.py pins Lean 4.19.0, compiles with warnings as errors, and checks Lean-reported transitive axioms for every exported theorem plus the executed kernel definitions. Only propext and Quot.sound are permitted. The test-only JSONL revision scir-symbol-reference/1 executes that reference from SymbolReference.lean using canonical scir-relations/1.0 occurrence tables. It emits complete, rejected or incomplete observations. Its independent boundary is limited to 4096 nodes, edges, roots and renaming entries, and native maximum depth 128; a resource-limit result is not a partial semantic success. The comparison runs the public Python API on the identical captured inputs: all forests with up to three nodes over two labels with all total maps plus empty-map identity, seeded larger inputs, and authored Unicode and profile counterexamples. Independent expected observations and sequential-renaming/leaf-only mutants check that the comparison can fail. Inputs, outputs, source hashes, toolchain, assumptions and exact counts are retained in ignored .build/symbol-reference and CI evidence. The Lean model does not prove Python execution, the JSON or relations codec, Unicode admission, resource bounds, parser fidelity, matching, variable substitution, references, retrieval, source truth or consumer profile validity. Those boundaries remain empirical tests or future work; no runtime Lean dependency is introduced.")), dependsOn("scir.tuple"("scir.ref"(SymbolRelabeling), "scir.ref"(SelfOwnedContracts))), models("scir.tuple"(model("proofs/SymbolLaws.lean", reference_sound), model("proofs/SymbolLaws.lean", reference_complete))), ownership(record), source("scir.ref"(SymbolReferenceBoundary)), tests("scir.tuple"(test("tests/test_symbol_reference.py", "SymbolReferenceTests.test_authored_observation_and_meaningful_mutants"), test("tests/test_symbol_reference.py", "SymbolReferenceTests.test_corpus_has_independent_small_forest_coverage_and_replays"), test("tests/test_symbol_reference.py", "SymbolReferenceTests.test_axiom_gate_rejects_missing_or_transitively_admitted_claims"), test("tests/test_symbol_reference.py", "SymbolReferenceTests.test_the_executed_reference_is_wired_to_the_pinned_ci_gate")))))
record(OpenSubstitution, Requirement, substitute(namedVariables, once), "scir.kw"(area(Patterns), contract("scir.text"("scir.patterns.substitute(pattern: Pattern, substitutions: Mapping[str, Pattern]) -> Pattern is the open-variable operation introduced in implementation 1.3.0. It reuses existing Node | Var; it does not add variables to native ground Terms. Every mapping key is an existing valid ASCII Var name except underscore, and every input and replacement is a wildcard-free Pattern. Validate all entries, including unused ones, before constructing a result. Missing variables remain Var(name); a mapped variable is replaced once by its supplied Pattern. Do not recurse into an inserted replacement. In particular x -> f(?x) is finite, and x -> ?y, y -> A maps ?x to ?y in one application. Literal Node heads, including x, ?x, underscore, Var, Node and lambda, remain exact symbols. All named variables are free; SCIR has no binders or implicit capture-avoidance semantics. With P(S,V) = V + S x List(P(S,V)), substitute(var,p) = p, substitute(sigma,var(v)) = sigma(v), and substitute(tau,substitute(sigma,p)) = substitute(v -> substitute(tau,sigma(v)),p). Finite mappings extend by the identity variable outside their domains. The API snapshots the mapping, preserves source values and visits ordinary constructed patterns iteratively; parser, formatting, equality and aggregate expansion bounds are separate existing caller boundaries. The legacy ground instantiate requires each used binding to be a Term and rejects missing variables or wildcards; its existing behavior is unchanged. Anonymous wildcards remain valid for matching and are deliberately excluded from the open substitution algebra.")), dependsOn("scir.tuple"("scir.ref"(SymbolValues), "scir.ref"(ContentWithoutCaptures), "scir.ref"(SelfOwnedContracts))), models("scir.tuple"(model("proofs/SubstitutionLaws.lean", substitution_sound), model("proofs/SubstitutionLaws.lean", substitution_complete), model("proofs/SubstitutionLaws.lean", substitution_identity), model("proofs/SubstitutionLaws.lean", substitution_variable), model("proofs/SubstitutionLaws.lean", substitution_composition))), ownership(record), source("scir.ref"(OpenSubstitution)), tests("scir.tuple"(test("tests/test_substitution.py", "SubstitutionTests.test_simultaneous_insertion_keeps_unmapped_variables_open"), test("tests/test_substitution.py", "SubstitutionTests.test_self_replacement_is_finite_and_has_no_occurs_check"), test("tests/test_substitution.py", "SubstitutionTests.test_node_heads_and_binder_looking_labels_remain_literal"), test("tests/test_substitution.py", "SubstitutionTests.test_composition_substitutes_into_the_first_environment"), test("tests/test_substitution.py", "SubstitutionTests.test_wildcards_are_excluded_even_in_unused_replacements"), test("tests/test_substitution.py", "SubstitutionTests.test_input_and_whole_environment_are_validated_without_mutation"), test("tests/test_substitution.py", "SubstitutionTests.test_substitution_traversal_is_stack_safe_for_constructed_patterns")))))
record(PatternReconstruction, Requirement, reconstruct(successfulWildcardFreeMatch), "scir.kw"(area(Patterns), dependsOn("scir.tuple"("scir.ref"(RepeatedCapture), "scir.ref"(EmptyMatch))), evidence("scir.tuple"("scir.ref"(PatternReferenceBoundary))), models("scir.tuple"(model("proofs/SubstitutionLaws.lean", instantiation_complete), model("proofs/SubstitutionLaws.lean", instantiation_sound), model("proofs/SubstitutionLaws.lean", match_reconstruction), model("proofs/SubstitutionLaws.lean", match_sound))), ownership(index), source(section("docs/theory.md", Matching)), tests("scir.tuple"(test("tests/test_substitution.py", "SubstitutionTests.test_grounding_and_reconstruction_keep_the_existing_boundary"), test("tests/test_substitution_reference.py", "SubstitutionReferenceTests.test_repeated_capture_mutant_and_empty_success_are_distinguished")))))
record(PatternReferenceBoundary, Limitation, separate(abstractReference, runtimeConformance), "scir.kw"(area(Evidence), contract("scir.text"("SubstitutionLaws.lean proves open substitution soundness and completeness against the independent Substituted relation, its identity/variable/composition laws, ground instantiation soundness and completeness against Instantiates, and successful reference-match reconstruction. The reference matcher first collects tentative captures and then checks full ground reconstruction; production matching uses incremental capture consistency. The proof does not establish matcher completeness, Python execution, parser fidelity, codecs, ASCII name validation or resource enforcement. tools/check_substitution_reference.py pins Lean 4.19.0, rejects admissions and replacement executable declarations, and audits transitive assumptions of every exported theorem and executed model definition; only propext and Quot.sound are allowed. The actual JSONL reference uses revision scir-substitution-reference/1 and the shared test-only ReferenceCodec. Pattern constructors are explicitly lowered to ordinary native Node(label, children...) and Var(name) terms in scir-relations/1.0; those tags have no added production meaning. Complete, rejected and incomplete results remain distinct; diagnostic prose is excluded from semantic comparison. Each transported forest and serialized result has a 4096-node and depth-128 limit; substitution environments have at most 4096 entries. These are reference-codec bounds, not a new aggregate runtime limit. The captured corpus enumerates 60 open patterns of up to three nodes over two labels and two variables, every mapping into the four one-node patterns plus empty identity, every pairing with 22 small ground terms, and all nine partial two-variable ground environments over two leaves. Seeded and authored cases supplement this domain. Compare the public substitute, match and instantiate operations to the executed reference, including missing bindings, noncommuting substitutions, literal labels and repeated captures; sequential-substitution and ignored-repeat mutants must disagree. The two existing symbol and new substitution gates retain source/toolchain hashes, inputs, outputs, assumptions and exact observations in ignored build artifacts and CI evidence. Passing this bounded comparison is not an unbounded Python proof or an evidence/truth inference.")), dependsOn("scir.tuple"("scir.ref"(OpenSubstitution), "scir.ref"(SelfOwnedContracts))), ownership(record), source("scir.ref"(PatternReferenceBoundary)), tests("scir.tuple"(test("tests/test_substitution_reference.py", "SubstitutionReferenceTests.test_independent_substitution_observation_detects_sequential_mutant"), test("tests/test_substitution_reference.py", "SubstitutionReferenceTests.test_repeated_capture_mutant_and_empty_success_are_distinguished"), test("tests/test_substitution_reference.py", "SubstitutionReferenceTests.test_corpus_replays_and_has_complete_small_domain_products"), test("tests/test_substitution_reference.py", "SubstitutionReferenceTests.test_pinned_ci_executes_both_references")))))
